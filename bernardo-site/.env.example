# Credenciales de la "OAuth App" de GitHub (github.com → Settings → Developer settings
# → OAuth Apps → New OAuth App). Copiar este archivo a ".env" para probar en local,
# y agregar las mismas 2 variables en Vercel → Project Settings → Environment Variables
# para que funcionen en producción.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
