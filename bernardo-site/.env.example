# Credenciales de la "OAuth App" de GitHub (github.com → Settings → Developer settings
# → OAuth Apps). Las usa solo el login del panel /admin: src/pages/api/auth.ts y
# src/pages/api/callback.ts.
#
# EN PRODUCCIÓN: Netlify → Project configuration → Environment variables.
# (El sitio migró de Vercel a Netlify en septiembre de 2026.) Las variables no toman
# efecto hasta el siguiente deploy, así que después de cambiarlas hay que redesplegar.
#
# EN LOCAL: ojo, copiar este archivo a ".env" y correr "npm run dev" NO alcanza para
# probar el login. Las rutas leen las variables con process.env, no con import.meta.env
# —a propósito: import.meta.env las reemplaza al compilar y el client secret terminaría
# escrito en texto plano dentro del bundle desplegado— y Vite no vuelca el .env a
# process.env. Para probar el login en local hay que levantar con "netlify dev", que sí
# inyecta las variables del proyecto en process.env.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
