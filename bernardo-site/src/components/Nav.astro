---
import nav from '../data/nav.json';

interface Props {
  active?: string;
}

const { active = '' } = Astro.props;

// Un título vacío en "Títulos menú" saca ese enlace del menú sin borrar la
// página: sigue existiendo en su dirección, sólo deja de estar anunciada.
// Así se mantiene /modelo fuera del menú hasta que Bernardo la tenga lista.
const links = [
  { href: '/retratos', label: nav.retratos },
  { href: '/proyectos', label: nav.proyectos },
  { href: '/estudio', label: nav.estudio },
  { href: '/servicios', label: nav.servicios },
  { href: '/sobre-mi', label: nav.sobremi },
  { href: '/contacto', label: nav.contacto },
  { href: '/modelo', label: nav.modelo },
].filter((link) => link.label && link.label.trim());
---

<nav class="site-nav">
	<a class="word" href="/">Bernardo Combeau</a>
	<span class="links">
		{links.map((link) => (
			<a href={link.href} class:list={{ on: active === link.href }}>{link.label}</a>
		))}
	</span>
</nav>
