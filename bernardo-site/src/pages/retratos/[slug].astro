---
export const prerender = true;

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Visor from '../../components/modelo/Visor.astro';
import { conVisor } from '../../lib/modelo.js';

export async function getStaticPaths() {
  const entries = await getCollection('retratos');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, year, excerpt, images, client, publication, cover } = entry.data;

// "Publicado en" es para un medio EXTERNO — un nombre de un solo carácter (placeholder
// tipo "-" o ".") o un link que apunta al propio sitio no cuenta como publicación real
// (pasó con las 3 entradas de Encargos: quedó guardado así por error desde el panel).
const hasRealPublication =
  publication?.name?.trim().length > 1 &&
  publication?.url &&
  !publication.url.includes('bernardocombeau.cl');

const allEntries = (await getCollection('retratos')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allEntries.findIndex((e) => e.id === entry.id);
const prevEntry = allEntries[currentIndex - 1];
const nextEntry = allEntries[currentIndex + 1];

// ImageObject por foto real de la galería — mismos datos ya presentes en el
// frontmatter (alt, lugar, año, crédito), nada inventado.
const imageObjects = images.map((img) => ({
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  contentUrl: new URL(img.src, Astro.site).toString(),
  name: img.alt,
  description: img.alt,
  ...(img.place && { contentLocation: img.place }),
  ...(img.year && { datePublished: img.year }),
  creator: { '@id': new URL('/#persona', Astro.site).toString() },
  copyrightHolder: { '@id': new URL('/#persona', Astro.site).toString() },
}));

const imagesV = await conVisor(images);
---

<Layout title={`${title} — Bernardo Combeau`} description={excerpt} image={cover.src} jsonLd={imageObjects}>
	<Nav active="/retratos" />

	<p class="crumb"><a href="/retratos">Retratos /</a></p>
	<div class="serie-head">
		<h2>{title}</h2>
		<p class="y">{[year, client].filter(Boolean).join(' · ')}</p>
		<p>{excerpt}</p>
	</div>

	<div class="gallery" data-visor-grupo>
		{imagesV.map((img) => (
			<button class="card" type="button" aria-haspopup="dialog"
				data-lb={JSON.stringify(img.lb)} data-alt={img.alt}
				data-caption={[img.place, img.year, img.credit].filter(Boolean).join(' · ')}>
				<div class="photo" style={[img.focus && `--focus:${img.focus}`, img.zoom && `--zoom:${img.zoom}`, img.flip && '--flip:-1'].filter(Boolean).join(';') || undefined}><Image src={img.src} alt={img.alt} width={828} height={Math.round(828 * (img.hReal / img.wReal))} quality={80} /></div>
				{(img.place || img.year || img.credit) && (
					<div class="cap">
						<span>{img.place}</span>
						<span>{[img.year, img.credit].filter(Boolean).join(' · ')}</span>
					</div>
				)}
			</button>
		))}
	</div>

	{hasRealPublication && (
		<div class="ext"><a href={publication.url} target="_blank" rel="noopener">Publicado en — {publication.name} →</a></div>
	)}

	<div class="serie-nav">
		{prevEntry ? <a href={`/retratos/${prevEntry.id}`}>← {prevEntry.data.title}</a> : <a href="/">← Volver a Home</a>}
		{nextEntry ? <a href={`/retratos/${nextEntry.id}`}>{nextEntry.data.title} →</a> : <a href="/retratos">Volver a Retratos →</a>}
	</div>

	<Footer />
	<Visor />
</Layout>
