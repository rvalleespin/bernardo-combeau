---
export const prerender = true;

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const entries = (await getCollection('retratos')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Retratos — Bernardo Combeau" description="Retratos de Bernardo Combeau, fotógrafo en Santiago, Chile — masculinos, femeninos, corporativos, modelos y actores.">
	<Nav active="/retratos" />
	<div class="page-head"><h2>Retratos</h2></div>
	<div class="grid">
		{entries.map((entry) => (
			<a class="card" href={`/retratos/${entry.id}`}>
				<div class="photo"><Image src={entry.data.cover.src} alt={entry.data.cover.alt} width={800} quality={80} /></div>
				<div class="cap2"><span class="t">{entry.data.title}</span><span class="y">{entry.data.year}</span></div>
			</a>
		))}
	</div>
	<Footer />
</Layout>
