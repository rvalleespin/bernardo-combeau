---
export const prerender = true;

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const entries = await getCollection('proyectos');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, year, excerpt, images, client, publication, cover } = entry.data;

// "Publicado en" es para un medio EXTERNO — un nombre de un solo carácter (placeholder
// tipo "-" o ".") o un link que apunta al propio sitio no cuenta como publicación real
// (pasó con las 3 entradas de Encargos: quedó guardado así por error desde el panel).
const hasRealPublication =
  publication?.name?.trim().length > 1 &&
  publication?.url &&
  !publication.url.includes('bernardocombeau.cl');

const allEntries = (await getCollection('proyectos')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allEntries.findIndex((e) => e.id === entry.id);
const prevEntry = allEntries[currentIndex - 1];
const nextEntry = allEntries[currentIndex + 1];

// ImageObject por foto real de la galería — mismos datos ya presentes en el
// frontmatter (alt, lugar, año, crédito), nada inventado.
const imageObjects = images.map((img) => ({
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  contentUrl: new URL(img.src, Astro.site).toString(),
  name: img.alt,
  description: img.alt,
  ...(img.place && { contentLocation: img.place }),
  ...(img.year && { datePublished: img.year }),
  creator: { '@id': new URL('/#persona', Astro.site).toString() },
  copyrightHolder: { '@id': new URL('/#persona', Astro.site).toString() },
}));
---

<Layout title={`${title} — Bernardo Combeau`} description={excerpt} image={cover.src} jsonLd={imageObjects}>
	<Nav active="/proyectos" />

	<p class="crumb"><a href="/proyectos">Proyectos /</a></p>
	<div class="serie-head">
		<h2>{title}</h2>
		<p class="y">{[year, client].filter(Boolean).join(' · ')}</p>
		<p>{excerpt}</p>
	</div>

	<div class="gallery">
		{images.map((img, i) => (
			<a class="card" href={`#foto-${i}`}>
				<div class="photo"><Image src={img.src} alt={img.alt} width={828} quality={80} /></div>
				{(img.place || img.year || img.credit) && (
					<div class="cap">
						<span>{img.place}</span>
						<span>{[img.year, img.credit].filter(Boolean).join(' · ')}</span>
					</div>
				)}
			</a>
		))}
	</div>

	{hasRealPublication && (
		<div class="ext"><a href={publication.url} target="_blank" rel="noopener">Publicado en — {publication.name} →</a></div>
	)}

	{images.map((img, i) => (
		<div class="lightbox" id={`foto-${i}`}>
			<a href="#" class="lightbox-close" aria-label="Cerrar">✕</a>
			{i > 0 && <a href={`#foto-${i - 1}`} class="lightbox-prev" aria-label="Foto anterior">←</a>}
			<figure class="lightbox-media">
				<Image src={img.src} alt={img.alt} width={1920} quality={80} />
				{(img.place || img.year || img.credit) && (
					<figcaption class="lightbox-cap">
						<span>{img.place}</span>
						<span>{[img.year, img.credit].filter(Boolean).join(' · ')}</span>
					</figcaption>
				)}
			</figure>
			{i < images.length - 1 && <a href={`#foto-${i + 1}`} class="lightbox-next" aria-label="Foto siguiente">→</a>}
		</div>
	))}

	<div class="serie-nav">
		{prevEntry ? <a href={`/proyectos/${prevEntry.id}`}>← {prevEntry.data.title}</a> : <a href="/">← Volver a Home</a>}
		{nextEntry ? <a href={`/proyectos/${nextEntry.id}`}>{nextEntry.data.title} →</a> : <a href="/proyectos">Volver a Proyectos →</a>}
	</div>

	<Footer />
</Layout>
