---
export const prerender = true;

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { altoParaAncho } from '../../lib/modelo.js';

const entriesBase = (await getCollection('proyectos')).sort((a, b) => a.data.order - b.data.order);
const entries = await Promise.all(entriesBase.map(async (e) => ({ ...e, coverAlto: await altoParaAncho(e.data.cover.src, 828) })));
---

<Layout title="Proyectos — Bernardo Combeau" description="Proyectos de carácter personal de Bernardo Combeau, fotógrafo en Santiago, Chile.">
	<Nav active="/proyectos" />
	<div class="page-head"><h2>Proyectos</h2></div>
	<div class="grid">
		{entries.map((entry) => (
			<a class="card" href={`/proyectos/${entry.id}`}>
				<div class="photo" style={[entry.data.cover.focus && `--focus:${entry.data.cover.focus}`, entry.data.cover.zoom && `--zoom:${entry.data.cover.zoom}`, entry.data.cover.flip && '--flip:-1'].filter(Boolean).join(';') || undefined}><Image src={entry.data.cover.src} alt={entry.data.cover.alt} width={828} height={entry.coverAlto} quality={80} /></div>
				<div class="cap2"><span class="t">{entry.data.title}</span><span class="y">{entry.data.year}</span></div>
			</a>
		))}
	</div>
	<Footer />
</Layout>
