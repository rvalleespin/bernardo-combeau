---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Photo from '../components/Photo.astro';

import encargo1 from '../assets/fotos/bernardo-portafolio-10-auto-binoculares.png';
import encargo2 from '../assets/fotos/bernardo-portafolio-03-piscina-corbata.png';
import encargo3 from '../assets/fotos/bernardo-portafolio-11-estudio-taburete.png';
---

<Layout title="Encargos — Bernardo Combeau">
	<Nav active="/encargos" />
	<div class="page-head"><h2>Encargos</h2></div>
	<div class="grid">
		<div class="card">
			<Photo src={encargo1} alt="Encargo — auto y binoculares" widths={[400, 640, 900]} sizes="(min-width: 820px) 33vw, 50vw" />
			<div class="cap2"><span class="t">Nombre del encargo</span><span class="y">2026</span></div>
		</div>
		<div class="card">
			<Photo src={encargo2} alt="Encargo — piscina y corbata" widths={[400, 640, 900]} sizes="(min-width: 820px) 33vw, 50vw" />
			<div class="cap2"><span class="t">Nombre del encargo</span><span class="y">2025</span></div>
		</div>
		<div class="card">
			<Photo src={encargo3} alt="Encargo — taburete de estudio" widths={[400, 640, 900]} sizes="(min-width: 820px) 33vw, 50vw" />
			<div class="cap2"><span class="t">Nombre del encargo</span><span class="y">2025</span></div>
		</div>
	</div>

	<Footer />
</Layout>
