---
export const prerender = true;

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

import home from '../data/home.json';
import nav from '../data/nav.json';

const heroLines = home.fraseHero.split('\n');

// Mismo criterio que en Nav.astro: título vacío deja el enlace fuera del
// menú sin borrar la página.
const navLinks = [
  { href: '/retratos', label: nav.retratos },
  { href: '/proyectos', label: nav.proyectos },
  { href: '/estudio', label: nav.estudio },
  { href: '/servicios', label: nav.servicios },
  { href: '/sobre-mi', label: nav.sobremi },
  { href: '/contacto', label: nav.contacto },
  { href: '/modelo', label: nav.modelo },
].filter((link) => link.label && link.label.trim());

const retratosEntries = (await getCollection('retratos')).sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ href: `/retratos/${e.id}`, title: e.data.title, year: e.data.year, cover: e.data.cover }))
  .slice(0, 6);
const proyectosEntries = (await getCollection('proyectos')).sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ href: `/proyectos/${e.id}`, title: e.data.title, year: e.data.year, cover: e.data.cover }))
  .slice(0, 6);
---

<Layout title="Bernardo Combeau — Fotografía">
	<div class="hero">
		<div class="scrim"></div>
		<nav class="hero-nav">
			<a class="word" href="/">Bernardo Combeau</a>
			<span class="links">
				{navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
			</span>
		</nav>
		<div class="photo"><Image src={home.fotoHero} alt="Retrato — Bernardo Combeau" width={1920} quality={80} loading="eager" fetchpriority="high" /></div>
		<div class="overlay">
			<h1>{heroLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h1>
			<a class="cta-pill" href="/retratos">Ver retratos →</a>
		</div>
		<div class="credit">{home.creditoHero}</div>
	</div>

	<div class="feed">
		<div class="feed-title"><h2>Retratos</h2></div>
		<div class="grid">
			{retratosEntries.map((item) => (
				<a class="card" href={item.href}>
					<div class="photo" style={item.cover.focus ? `--focus:${item.cover.focus}` : undefined}><Image src={item.cover.src} alt={item.cover.alt} width={828} quality={80} /></div>
					<div class="cap2"><span class="t">{item.title}</span><span class="y">{item.year}</span></div>
				</a>
			))}
		</div>
	</div>

	<div class="feed">
		<div class="feed-title"><h2>Proyectos</h2></div>
		<div class="grid">
			{proyectosEntries.map((item) => (
				<a class="card" href={item.href}>
					<div class="photo" style={item.cover.focus ? `--focus:${item.cover.focus}` : undefined}><Image src={item.cover.src} alt={item.cover.alt} width={828} quality={80} /></div>
					<div class="cap2"><span class="t">{item.title}</span><span class="y">{item.year}</span></div>
				</a>
			))}
		</div>
	</div>

	<Footer />
</Layout>
