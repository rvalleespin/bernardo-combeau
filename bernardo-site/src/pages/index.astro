---
export const prerender = true;

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

import home from '../data/home.json';

const heroLines = home.fraseHero.split('\n');

const navLinks = [
  { href: '/series', label: 'Series' },
  { href: '/encargos', label: 'Encargos' },
  { href: '/estudio', label: 'Estudio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/contacto', label: 'Contacto' },
];

const seriesEntries = (await getCollection('series')).sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ href: `/series/${e.id}`, title: e.data.title, year: e.data.year, cover: e.data.cover }));
const encargosEntries = (await getCollection('encargos')).sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ href: `/encargos/${e.id}`, title: e.data.title, year: e.data.year, cover: e.data.cover }));

const feedItems = [...seriesEntries, ...encargosEntries].slice(0, 6);
---

<Layout title="Bernardo Combeau — Fotografía">
	<div class="hero">
		<div class="scrim"></div>
		<nav class="hero-nav">
			<a class="word" href="/">Bernardo Combeau</a>
			<span class="links">
				{navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
			</span>
		</nav>
		<div class="photo"><Image src={home.fotoHero} alt="Retrato — Bernardo Combeau" width={1920} quality={80} /></div>
		<div class="overlay">
			<h1>{heroLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h1>
			<a class="cta-pill" href="/series">Ver serie →</a>
		</div>
		<div class="credit">{home.creditoHero}</div>
	</div>

	<div class="feed">
		<div class="feed-title"><h2>Lo último</h2></div>
		<div class="grid">
			{feedItems.map((item) => (
				<a class="card" href={item.href}>
					<div class="photo"><Image src={item.cover.src} alt={item.cover.alt} width={800} quality={80} /></div>
					<div class="cap2"><span class="t">{item.title}</span><span class="y">{item.year}</span></div>
				</a>
			))}
		</div>
	</div>

	<Footer />
</Layout>
