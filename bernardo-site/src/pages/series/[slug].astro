---
export const prerender = true;

import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const entries = await getCollection('series');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, year, excerpt, images, cover } = entry.data;

const allEntries = (await getCollection('series')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allEntries.findIndex((e) => e.id === entry.id);
const prevEntry = allEntries[currentIndex - 1];
const nextEntry = allEntries[currentIndex + 1];
---

<Layout title={`${title} — Bernardo Combeau`} description={excerpt} image={cover.src}>
	<Nav active="/series" />

	<p class="crumb"><a href="/series">Series /</a></p>
	<div class="serie-head">
		<h2>{title}</h2>
		<p class="y">{year}</p>
		<p>{excerpt}</p>
	</div>

	<div class="gallery">
		{images.map((img, i) => (
			<a class="card" href={`#foto-${i}`}>
				<div class="photo"><img src={img.src} alt={img.alt} /></div>
				{(img.place || img.year || img.credit) && (
					<div class="cap">
						<span>{img.place}</span>
						<span>{[img.year, img.credit].filter(Boolean).join(' · ')}</span>
					</div>
				)}
			</a>
		))}
	</div>

	{images.map((img, i) => (
		<div class="lightbox" id={`foto-${i}`}>
			<a href="#" class="lightbox-close" aria-label="Cerrar">✕</a>
			{i > 0 && <a href={`#foto-${i - 1}`} class="lightbox-prev" aria-label="Foto anterior">←</a>}
			<figure class="lightbox-media">
				<img src={img.src} alt={img.alt} />
				{(img.place || img.year || img.credit) && (
					<figcaption class="lightbox-cap">
						<span>{img.place}</span>
						<span>{[img.year, img.credit].filter(Boolean).join(' · ')}</span>
					</figcaption>
				)}
			</figure>
			{i < images.length - 1 && <a href={`#foto-${i + 1}`} class="lightbox-next" aria-label="Foto siguiente">→</a>}
		</div>
	))}

	<div class="serie-nav">
		{prevEntry ? <a href={`/series/${prevEntry.id}`}>← {prevEntry.data.title}</a> : <a href="/">← Volver a Home</a>}
		{nextEntry ? <a href={`/series/${nextEntry.id}`}>{nextEntry.data.title} →</a> : <a href="/series">Volver a Series →</a>}
	</div>

	<Footer />
</Layout>
