---
export const prerender = true;

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const entries = await getCollection('encargos');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, year, excerpt, images, client, publication, cover } = entry.data;

const allEntries = (await getCollection('encargos')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allEntries.findIndex((e) => e.id === entry.id);
const prevEntry = allEntries[currentIndex - 1];
const nextEntry = allEntries[currentIndex + 1];
---

<Layout title={`${title} — Bernardo Combeau`} description={excerpt} image={cover.src}>
	<Nav active="/encargos" />

	<p class="crumb"><a href="/encargos">Encargos /</a></p>
	<div class="serie-head">
		<h2>{title}</h2>
		<p class="y">{[year, client].filter(Boolean).join(' · ')}</p>
		<p>{excerpt}</p>
	</div>

	<div class="gallery">
		{images.map((img, i) => (
			<a class="card" href={`#foto-${i}`}>
				<div class="photo"><Image src={img.src} alt={img.alt} width={800} quality={80} /></div>
				{(img.place || img.year || img.credit) && (
					<div class="cap">
						<span>{img.place}</span>
						<span>{[img.year, img.credit].filter(Boolean).join(' · ')}</span>
					</div>
				)}
			</a>
		))}
	</div>

	{publication && (
		<div class="ext"><a href={publication.url} target="_blank" rel="noopener">Publicado en — {publication.name} →</a></div>
	)}

	{images.map((img, i) => (
		<div class="lightbox" id={`foto-${i}`}>
			<a href="#" class="lightbox-close" aria-label="Cerrar">✕</a>
			{i > 0 && <a href={`#foto-${i - 1}`} class="lightbox-prev" aria-label="Foto anterior">←</a>}
			<figure class="lightbox-media">
				<Image src={img.src} alt={img.alt} width={1600} quality={80} />
				{(img.place || img.year || img.credit) && (
					<figcaption class="lightbox-cap">
						<span>{img.place}</span>
						<span>{[img.year, img.credit].filter(Boolean).join(' · ')}</span>
					</figcaption>
				)}
			</figure>
			{i < images.length - 1 && <a href={`#foto-${i + 1}`} class="lightbox-next" aria-label="Foto siguiente">→</a>}
		</div>
	))}

	<div class="serie-nav">
		{prevEntry ? <a href={`/encargos/${prevEntry.id}`}>← {prevEntry.data.title}</a> : <a href="/">← Volver a Home</a>}
		{nextEntry ? <a href={`/encargos/${nextEntry.id}`}>{nextEntry.data.title} →</a> : <a href="/encargos">Volver a Encargos →</a>}
	</div>

	<Footer />
</Layout>
