---
export const prerender = true;

import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import modelo from '../../data/modelo.json';
import contacto from '../../data/contacto.json';

const { heroFoto, heroCaption, galeria, identity, selectedWork, reelUrl, polaroids, details, booking } = modelo;

// Acepta un link normal de YouTube o Vimeo y lo convierte al formato embebible.
// El reel siempre vive en una plataforma externa — no se sube el archivo de
// video al repo (Git no es un lugar razonable para video pesado).
function toEmbedUrl(url) {
  if (!url) return null;
  const yt = url.match(/(?:youtu\.be\/|youtube\.com\/watch\?v=|youtube\.com\/embed\/)([\w-]+)/);
  if (yt) return `https://www.youtube.com/embed/${yt[1]}`;
  const vimeo = url.match(/vimeo\.com\/(\d+)/);
  if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}`;
  return url;
}

const reelEmbed = toEmbedUrl(reelUrl);

// Tres columnas, como pidió Bernardo: la altura sola, las tres medidas de
// cuerpo siempre juntas, y el resto de los rasgos aparte. Cada columna se
// cae sola si no tiene ningún dato cargado.
const detailGroups = [
  [['Height', details?.height]],
  [['Chest', details?.chest], ['Waist', details?.waist], ['Hips', details?.hips]],
  [['Shoes', details?.shoes], ['Hair', details?.hair], ['Eyes', details?.eyes]],
]
  .map((group) => group.filter(([, v]) => v))
  .filter((group) => group.length > 0);

const whatsappDigits = (contacto.whatsapp || '').replace(/\D/g, '');
---

<Layout title="Bernardo Combeau — Model" description="Bernardo Combeau, model based in Santiago, Chile — fashion, commercial, e-commerce and advertising." image={heroFoto || undefined}>
	<div class="modelo">
		<header class="mhead">
			<span class="wordmark">Bernardo Combeau</span>
			<a class="back" href="/">← Volver a fotografía</a>
		</header>

		{heroFoto && (
			<div class="mhero-wrap">
				<div class="mhero">
					<Image src={heroFoto} alt="Bernardo Combeau" width={1800} quality={82} loading="eager" fetchpriority="high" />
					<div class="mhero-scrim"></div>
				</div>
				<div class="mhero-overlay">
					<span class="word">Bernardo Combeau <em>Model</em></span>
				</div>
			</div>
		)}

		{heroCaption && <p class="hero-caption">{heroCaption}</p>}

		{galeria && galeria.length > 0 && (
			<section class="mgallery">
				<div class="grid-12">
					{galeria.slice(0, 12).map((img) => (
						<div class="photo"><Image src={img.src} alt={img.alt || 'Bernardo Combeau'} width={1200} quality={80} /></div>
					))}
				</div>
				{selectedWork && selectedWork.length > 0 && (
					<div class="book-cta"><a href="#selected-work">Ver book completo →</a></div>
				)}
			</section>
		)}

		{identity && (
			<div class="identity"><p>{identity}</p></div>
		)}

		{selectedWork && selectedWork.length > 0 && (
			<section class="mgallery" id="selected-work">
				<h2>Selected Work</h2>
				<div class="work-list">
					{selectedWork.map((job) => (
						<div class="work-item">
							<div class="work-head">
								<span class="work-name">{job.nombre}</span>
								{job.detalle && <span class="work-detalle">{job.detalle}</span>}
							</div>
							<div class="grid-work">
								{(job.fotos || []).map((img) => (
									<div class="photo"><Image src={img.src} alt={img.alt || job.nombre} width={800} quality={80} /></div>
								))}
							</div>
						</div>
					))}
				</div>
			</section>
		)}

		{reelEmbed && (
			<section class="mgallery">
				<h2>Motion / Commercials</h2>
				<div class="reel"><iframe src={reelEmbed} title="Reel — Bernardo Combeau" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></div>
			</section>
		)}

		{polaroids && polaroids.length > 0 && (
			<section class="mgallery">
				<h2>Polaroids</h2>
				<div class="grid-polaroids">
					{polaroids.slice(0, 4).map((img) => (
						<div class="photo"><Image src={img.src} alt={img.alt || 'Bernardo Combeau'} width={600} quality={80} /></div>
					))}
				</div>
			</section>
		)}

		{detailGroups.length > 0 && (
			<section class="stats">
				<h2>Details</h2>
				<div class="stat-cols">
					{detailGroups.map((group) => (
						<dl class="stat-col">
							{group.map(([label, value]) => (
								<div class="stat">
									<dt>{label}</dt>
									<dd>{value}</dd>
								</div>
							))}
						</dl>
					))}
				</div>
			</section>
		)}

		<footer class="mfoot">
			<h2>Booking</h2>
			{booking?.region && <p class="region">{booking.region}</p>}
			<div class="contact-links">
				{contacto.email && <a href={`mailto:${contacto.email}`}>{contacto.email}</a>}
				{whatsappDigits && <a href={`https://wa.me/${whatsappDigits}`} target="_blank" rel="noopener">{contacto.whatsapp}</a>}
				{booking?.instagram && <a href={`https://instagram.com/${booking.instagram.replace(/^@/, '')}`} target="_blank" rel="noopener">{booking.instagram}</a>}
			</div>
			<a class="back" href="/">← Volver a fotografía</a>
		</footer>
	</div>
</Layout>

<style>
	.modelo{ --mp: #ffffff; --mi: #111110; --mm: #84817a; --ml: #e7e4dd;
		background:var(--mp); color:var(--mi); font-family:-apple-system,BlinkMacSystemFont,sans-serif; }
	/* Barra superior fija, como la referencia: el nombre vive acá arriba
	   además de ir sobre la foto. */
	.mhead{ position:sticky; top:0; z-index:10; background:var(--mp);
		display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.4rem 1.2rem;
		padding:1.1rem clamp(1.2rem,4vw,3rem); border-bottom:1px solid var(--ml); }
	.mhead .wordmark{ font-size:.9rem; font-weight:600; letter-spacing:.18em; text-transform:uppercase;
		color:var(--mi); }
	.mhead .back{ color:var(--mm); text-decoration:none; font-size:.8rem; }

	/* El hero es una banda apaisada recortada, no la foto entera a ancho
	   completo (así deja de salir gigante). El sujeto queda a la izquierda
	   del encuadre y el nombre cae sobre el fondo desenfocado de la derecha,
	   sin taparlo. */
	.mhero-wrap{ position:relative; }
	/* La referencia fija el hero en min-height:100vh. Acá se usa 16/9 con
	   tope de viewport: en pantallas anchas el tope evita que vuelva a
	   crecer de más, y como el recorte es más apaisado que la foto, el
	   ajuste siempre recorta arriba y abajo, nunca a los lados (que es
	   donde viven Bernardo y el nombre). */
	.mhero{ position:relative; width:100%; aspect-ratio:16/9; max-height:100vh; overflow:hidden; }
	.mhero img{ width:100%; height:100%; object-fit:cover; object-position:28% 34%; display:block; }
	.mhero-scrim{ position:absolute; inset:0; z-index:1;
		background:linear-gradient(270deg, rgba(0,0,0,.52) 0%, rgba(0,0,0,.28) 30%, rgba(0,0,0,0) 58%); }
	.mhero-overlay{ position:absolute; z-index:2; top:50%; transform:translateY(-50%);
		right:clamp(1.4rem,5vw,4.5rem); max-width:min(48%,32rem); text-align:right; }
	/* La referencia trackea los titulares en negativo (-0.02em) y aprieta el
	   interlineado a ~1.06 cuanto mas grande es el titular. */
	.mhero-overlay .word{ display:block; font-family:Georgia,'Times New Roman',serif; font-weight:400;
		font-size:clamp(1.6rem,3.5vw,3.2rem); line-height:1.06; letter-spacing:-.02em; color:#fff;
		text-shadow:0 1px 14px rgba(0,0,0,.35); }
	.mhero-overlay .word em{ font-style:italic; color:rgba(255,255,255,.72); }

	.hero-caption{ text-align:center; font-family:Georgia,'Times New Roman',serif; font-weight:300;
		font-size:.86rem; letter-spacing:.08em; color:var(--mm);
		margin:0; padding:clamp(1.3rem,3vw,2rem) clamp(1.2rem,4vw,3rem) 0; }

	/* En vertical no hay lugar para poner el nombre al lado sin pisarlo:
	   la foto se queda con él y el nombre pasa a la línea de abajo. */
	@media (max-width:760px){
		.mhero{ aspect-ratio:4/5; }
		.mhero img{ object-position:14% 32%; }
		.mhero-scrim{ display:none; }
		.mhero-overlay{ position:static; transform:none; max-width:none; text-align:center;
			padding:clamp(1.2rem,4vw,2rem) clamp(1.2rem,4vw,3rem) 0; }
		.mhero-overlay .word{ color:var(--mi); text-shadow:none; }
		.mhero-overlay .word em{ color:var(--mm); }
		.hero-caption{ padding-top:.5rem; }
	}

	/* Aire generoso entre fotos y entre secciones: es lo que da la lectura
	   de revista que pidió Bernardo. */
	.mgallery{ padding:clamp(2.6rem,7vw,5rem) clamp(1.4rem,5vw,4rem); }
	.mgallery h2{ font-family:Georgia,'Times New Roman',serif; font-weight:400; font-style:italic;
		font-size:1.45rem; letter-spacing:-.02em; line-height:1.11; margin:0 0 clamp(1.4rem,3vw,2.2rem); color:var(--mm); }

	.grid-12{ display:grid; grid-template-columns:1fr; gap:clamp(1.6rem,5vw,4rem); }
	@media (min-width:600px){ .grid-12{ grid-template-columns:repeat(2,1fr); } }
	.grid-12 .photo{ aspect-ratio:4/5; overflow:hidden; }
	.grid-12 .photo img{ width:100%; height:100%; object-fit:cover; display:block; }

	.book-cta{ text-align:center; padding-top:clamp(1.4rem,3vw,2rem); }
	.book-cta a{ display:inline-block; color:var(--mi); text-decoration:none; font-size:.8rem;
		letter-spacing:.08em; text-transform:uppercase; border:1px solid var(--ml); padding:.75rem 1.6rem; }

	.identity{ max-width:62ch; margin:0 auto; padding:clamp(2.4rem,6vw,4rem) clamp(1.2rem,4vw,3rem); }
	.identity p{ font-size:1.1rem; line-height:1.8; }

	.work-list{ display:flex; flex-direction:column; gap:clamp(2.2rem,5vw,3.2rem); }
	.work-head{ display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:.4rem 1rem;
		margin-bottom:1rem; border-bottom:1px solid var(--ml); padding-bottom:.6rem; }
	.work-name{ font-family:Georgia,'Times New Roman',serif; font-size:1.15rem; letter-spacing:.03em; }
	.work-detalle{ font-size:.75rem; letter-spacing:.05em; color:var(--mm); text-transform:uppercase; }
	.grid-work{ display:grid; grid-template-columns:repeat(2,1fr); gap:clamp(1.2rem,3.5vw,2.4rem); }
	@media (min-width:820px){ .grid-work{ grid-template-columns:repeat(4,1fr); } }
	.grid-work .photo{ aspect-ratio:3/4; overflow:hidden; }
	.grid-work .photo img{ width:100%; height:100%; object-fit:cover; display:block; }

	.reel{ position:relative; width:100%; max-width:800px; margin:0 auto; aspect-ratio:16/9; }
	.reel iframe{ position:absolute; inset:0; width:100%; height:100%; border:0; }

	.grid-polaroids{ display:grid; grid-template-columns:repeat(2,1fr); gap:clamp(1.2rem,3.5vw,2.4rem); }
	@media (min-width:640px){ .grid-polaroids{ grid-template-columns:repeat(4,1fr); } }
	.grid-polaroids .photo{ aspect-ratio:1/1; overflow:hidden; }
	.grid-polaroids .photo img{ width:100%; height:100%; object-fit:cover; display:block; }

	.stats{ padding:clamp(1.4rem,3vw,2.2rem) clamp(1.2rem,4vw,3rem) clamp(2.6rem,6vw,4rem); }
	.stats h2{ font-family:Georgia,'Times New Roman',serif; font-weight:400; font-style:italic;
		font-size:1.45rem; letter-spacing:-.02em; line-height:1.11; margin:0 0 1.2rem; color:var(--mm); }
	/* Tres columnas: la altura sola, las medidas de cuerpo juntas, el resto
	   aparte. Etiqueta y valor comparten tamaño y van pegados — se separan
	   por color, no por escala. */
	.stat-cols{ display:grid; grid-template-columns:1fr; gap:1.6rem 3rem; max-width:56rem; }
	@media (min-width:640px){ .stat-cols{ grid-template-columns:auto auto auto; justify-content:start; gap:1.6rem clamp(3rem,7vw,6rem); } }
	.stat-col{ display:flex; flex-direction:column; gap:.35rem; margin:0; }
	.stat{ display:flex; align-items:baseline; gap:.45rem; }
	.stats dt, .stats dd{ font-size:.98rem; line-height:1.4; letter-spacing:.01em; margin:0; }
	.stats dt{ color:var(--mm); }
	.stats dt::after{ content:" —"; }
	.stats dd{ color:var(--mi); }

	.mfoot{ display:flex; flex-direction:column; align-items:center; gap:1rem; text-align:center;
		padding:clamp(2rem,5vw,3rem) clamp(1.2rem,4vw,3rem) clamp(3rem,6vw,4rem); border-top:1px solid var(--ml); }
	.mfoot h2{ font-family:Georgia,'Times New Roman',serif; font-weight:400; font-style:italic;
		font-size:1.45rem; letter-spacing:-.02em; line-height:1.11; margin:0; color:var(--mm); }
	.mfoot .region{ font-size:.85rem; letter-spacing:.05em; color:var(--mm); margin:0; }
	.contact-links{ display:flex; gap:1.5rem; flex-wrap:wrap; justify-content:center; }
	.contact-links a{ color:var(--mi); text-decoration:none; font-size:.9rem; border-bottom:1px solid var(--mm); }
	.mfoot .back{ color:var(--mm); text-decoration:none; font-size:.82rem; margin-top:.6rem; }
</style>
