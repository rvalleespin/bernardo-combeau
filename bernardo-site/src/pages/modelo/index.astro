---
export const prerender = true;

import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import modelo from '../../data/modelo.json';
import contacto from '../../data/contacto.json';

const { heroFoto, heroCaption, galeria, identity, selectedWork, reelUrl, polaroids, details, booking } = modelo;

// El reel siempre vive en una plataforma externa — no se sube el archivo de
// video al repo (Git no es un lugar razonable para video pesado).
function parseReel(url) {
  if (!url) return null;
  const yt = url.match(/(?:youtu\.be\/|youtube\.com\/watch\?v=|youtube\.com\/embed\/)([\w-]+)/);
  if (yt) return { tipo: 'youtube', id: yt[1] };
  const vimeo = url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  if (vimeo) return { tipo: 'vimeo', id: vimeo[1] };
  return null;
}

const reel = parseReel(reelUrl);

// Reproducción de fondo: en silencio, en bucle y sin nada de interfaz. En
// YouTube el bucle sólo funciona si además se le pasa el propio id como
// playlist; Vimeo tiene su parámetro background que apaga toda la UI de una.
const reelFondo = !reel
  ? null
  : reel.tipo === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${reel.id}?autoplay=1&mute=1&loop=1&playlist=${reel.id}&controls=0&playsinline=1&disablekb=1&fs=0&iv_load_policy=3`
    : `https://player.vimeo.com/video/${reel.id}?background=1&autoplay=1&muted=1&loop=1&autopause=0`;

// El mismo video, pero para verlo de verdad al tocar el botón.
const reelLink = !reel
  ? null
  : reel.tipo === 'youtube'
    ? `https://www.youtube.com/watch?v=${reel.id}`
    : `https://vimeo.com/${reel.id}`;

// Tres columnas, como pidió Bernardo: la altura sola, las tres medidas de
// cuerpo siempre juntas, y el resto de los rasgos aparte. Cada columna se
// cae sola si no tiene ningún dato cargado.
const detailGroups = [
  [['Height', details?.height]],
  [['Chest', details?.chest], ['Waist', details?.waist], ['Hips', details?.hips]],
  [['Shoes', details?.shoes], ['Hair', details?.hair], ['Eyes', details?.eyes]],
]
  .map((group) => group.filter(([, v]) => v))
  .filter((group) => group.length > 0);

const whatsappDigits = (contacto.whatsapp || '').replace(/\D/g, '');
---

<Layout title="Bernardo Combeau — Model" description="Bernardo Combeau, model based in Santiago, Chile — fashion, commercial, e-commerce and advertising." image={heroFoto || undefined}>
	<div class="modelo">
		<header class="mhead">
			<span class="wordmark">Bernardo Combeau</span>
			<a class="back" href="/">← Volver a fotografía</a>
		</header>

		{heroFoto && (
			<div class="mhero-wrap">
				<div class="mhero">
					<Image src={heroFoto} alt="Bernardo Combeau" width={1800} quality={82} loading="eager" fetchpriority="high" />
					<div class="mhero-scrim"></div>
				</div>
				<div class="mhero-overlay">
					<span class="word">Bernardo Combeau <em>Model</em></span>
				</div>
			</div>
		)}

		{heroCaption && <p class="hero-caption">{heroCaption}</p>}

		{galeria && galeria.length > 0 && (
			<section class="mgallery" id="galeria">
				<div class="grid-12">
					{galeria.slice(0, 12).map((img) => (
						<button class="photo" type="button" data-full={img.src} data-alt={img.alt || 'Bernardo Combeau'}>
							<Image src={img.src} alt={img.alt || 'Bernardo Combeau'} width={1200} quality={80} />
						</button>
					))}
				</div>
				{selectedWork && selectedWork.length > 0 && (
					<div class="book-cta"><a href="#selected-work">Ver book completo →</a></div>
				)}
			</section>
		)}

		{identity && (
			<div class="identity"><p>{identity}</p></div>
		)}

		{selectedWork && selectedWork.length > 0 && (
			<section class="mgallery" id="selected-work">
				<h2>Selected Work</h2>
				<div class="work-list">
					{selectedWork.map((job) => (
						<div class="work-item">
							<div class="work-head">
								<span class="work-name">{job.nombre}</span>
								{job.detalle && <span class="work-detalle">{job.detalle}</span>}
							</div>
							<div class="grid-work">
								{(job.fotos || []).map((img) => (
									<button class="photo" type="button" data-full={img.src} data-alt={img.alt || job.nombre}>
										<Image src={img.src} alt={img.alt || job.nombre} width={800} quality={80} />
									</button>
								))}
							</div>
						</div>
					))}
				</div>
			</section>
		)}

		{reelFondo && (
			<section class="motion" aria-labelledby="motion-titulo">
				<div class="motion-video" aria-hidden="true">
					{/* El src lo pone el script: así no se carga si el visitante
					    pidió menos movimiento, y el botón de pausa puede cortarlo
					    de verdad en vez de sólo taparlo. */}
					<iframe data-src={reelFondo} title="Reel — Bernardo Combeau" frameborder="0" tabindex="-1"
						allow="autoplay; fullscreen; picture-in-picture"></iframe>
				</div>
				<div class="motion-scrim"></div>
				<div class="motion-contenido">
					<h2 id="motion-titulo">Motion / Commercials</h2>
					<div class="motion-acciones">
						<a class="btn" href="#galeria">Stills</a>
						<a class="btn" href={reelLink} target="_blank" rel="noopener">Motion</a>
					</div>
				</div>
				<button class="motion-pausa" type="button" hidden>Pausar fondo</button>
			</section>
		)}

		{polaroids && polaroids.length > 0 && (
			<section class="mgallery">
				<h2>Polaroids</h2>
				<div class="grid-polaroids">
					{polaroids.slice(0, 4).map((img) => (
						<button class="photo" type="button" data-full={img.src} data-alt={img.alt || 'Bernardo Combeau'}>
							<Image src={img.src} alt={img.alt || 'Bernardo Combeau'} width={600} quality={80} />
						</button>
					))}
				</div>
			</section>
		)}

		{detailGroups.length > 0 && (
			<section class="stats">
				<h2>Details</h2>
				<div class="stat-cols">
					{detailGroups.map((group) => (
						<dl class="stat-col">
							{group.map(([label, value]) => (
								<div class="stat">
									<dt>{label}</dt>
									<dd>{value}</dd>
								</div>
							))}
						</dl>
					))}
				</div>
			</section>
		)}

		<footer class="mfoot">
			<h2>Booking</h2>
			{booking?.region && <p class="region">{booking.region}</p>}
			<div class="contact-links">
				{contacto.email && <a href={`mailto:${contacto.email}`}>{contacto.email}</a>}
				{whatsappDigits && <a href={`https://wa.me/${whatsappDigits}`} target="_blank" rel="noopener">{contacto.whatsapp}</a>}
				{booking?.instagram && <a href={`https://instagram.com/${booking.instagram.replace(/^@/, '')}`} target="_blank" rel="noopener">{booking.instagram}</a>}
			</div>
			<a class="back" href="/">← Volver a fotografía</a>
		</footer>

		<dialog class="visor" aria-label="Foto a tamaño completo">
			<img class="visor-img" src="" alt="" />
			<button class="visor-btn visor-cerrar" type="button" aria-label="Cerrar">✕</button>
			<button class="visor-btn visor-prev" type="button" aria-label="Foto anterior">‹</button>
			<button class="visor-btn visor-next" type="button" aria-label="Foto siguiente">›</button>
			<p class="visor-pie"></p>
		</dialog>
	</div>
</Layout>

<script>
	// Franja de Motion. El video de fondo se monta desde acá y no desde el
	// HTML por dos razones: si el visitante pidió menos movimiento no se carga
	// nunca (un iframe de YouTube ignora esa preferencia por su cuenta), y el
	// botón de pausa puede cortarlo de verdad quitándole el src, en vez de
	// dejarlo corriendo tapado.
	const banda = document.querySelector('.motion');
	if (banda) {
		const marco = banda.querySelector('.motion-video iframe');
		const btn = banda.querySelector('.motion-pausa');
		const fuente = marco && marco.dataset.src;
		const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
		let corriendo = false;

		const encender = () => { if (!corriendo && fuente) { marco.src = fuente; corriendo = true; } };
		const apagar = () => { if (corriendo) { marco.removeAttribute('src'); corriendo = false; } };
		const rotular = () => { btn.textContent = corriendo ? 'Pausar fondo' : 'Reproducir fondo'; };

		if (fuente) {
			btn.hidden = false;
			if (menosMovimiento.matches) {
				rotular();
			} else if ('IntersectionObserver' in window) {
				// No cargar el reel hasta que la franja esté por entrar en pantalla.
				const obs = new IntersectionObserver((entradas) => {
					entradas.forEach((e) => { if (e.isIntersecting) { encender(); rotular(); obs.disconnect(); } });
				}, { rootMargin: '250px' });
				obs.observe(banda);
			} else {
				encender(); rotular();
			}
			rotular();
			btn.addEventListener('click', () => { corriendo ? apagar() : encender(); rotular(); });
		}
	}

	// Visor a tamaño completo. <dialog> nativo: ya trae el foco atrapado y el
	// cierre con Escape, así que no hace falta librería. Se muestra el archivo
	// original en vez de la miniatura optimizada, y se carga recién al abrir.
	const dlg = document.querySelector('.visor');
	if (dlg) {
		const img = dlg.querySelector('.visor-img');
		const pie = dlg.querySelector('.visor-pie');
		const fotos = Array.from(document.querySelectorAll('button.photo'));
		let i = 0;
		let origen = null;

		const pintar = () => {
			const f = fotos[i];
			img.src = f.dataset.full;
			img.alt = f.dataset.alt || '';
			pie.textContent = f.dataset.alt || '';
			const varias = fotos.length > 1;
			dlg.querySelector('.visor-prev').hidden = !varias;
			dlg.querySelector('.visor-next').hidden = !varias;
		};
		const mover = (paso) => { i = (i + paso + fotos.length) % fotos.length; pintar(); };

		fotos.forEach((f, idx) => f.addEventListener('click', () => {
			i = idx; origen = f; pintar(); dlg.showModal();
		}));

		// La limpieza va acá y no colgada del evento 'close': ese evento no
		// llega a dispararse en todos los navegadores, así que si dependiera
		// de él la foto quedaría cargada y el foco perdido. Es idempotente,
		// da igual si además llega el evento.
		const cerrar = () => {
			if (dlg.open) dlg.close();
			img.removeAttribute('src');
			if (origen) origen.focus();
		};

		dlg.querySelector('.visor-cerrar').addEventListener('click', cerrar);
		dlg.querySelector('.visor-prev').addEventListener('click', () => mover(-1));
		dlg.querySelector('.visor-next').addEventListener('click', () => mover(1));
		dlg.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') { e.preventDefault(); mover(-1); }
			if (e.key === 'ArrowRight') { e.preventDefault(); mover(1); }
		});
		// Clic en el fondo (fuera de la foto y de los botones) cierra.
		dlg.addEventListener('click', (e) => { if (e.target === dlg) cerrar(); });
		// Escape: lo maneja el navegador, así que se intercepta para que pase
		// igual por la limpieza.
		dlg.addEventListener('cancel', (e) => { e.preventDefault(); cerrar(); });
		dlg.addEventListener('close', cerrar);
	}
</script>

<style>
	.modelo{ --mp: #ffffff; --mi: #111110; --mm: #84817a; --ml: #e7e4dd;
		background:var(--mp); color:var(--mi); font-family:-apple-system,BlinkMacSystemFont,sans-serif; }
	/* Barra superior fija, como la referencia: el nombre vive acá arriba
	   además de ir sobre la foto. */
	.mhead{ position:sticky; top:0; z-index:10; background:var(--mp);
		display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.4rem 1.2rem;
		padding:1.1rem clamp(1.2rem,4vw,3rem); border-bottom:1px solid var(--ml); }
	.mhead .wordmark{ font-size:.9rem; font-weight:600; letter-spacing:.18em; text-transform:uppercase;
		color:var(--mi); }
	.mhead .back{ color:var(--mm); text-decoration:none; font-size:.8rem; }

	/* El hero es una banda apaisada recortada, no la foto entera a ancho
	   completo (así deja de salir gigante). El sujeto queda a la izquierda
	   del encuadre y el nombre cae sobre el fondo desenfocado de la derecha,
	   sin taparlo. */
	.mhero-wrap{ position:relative; }
	/* La referencia fija el hero en min-height:100vh. Acá se usa 16/9 con
	   tope de viewport: en pantallas anchas el tope evita que vuelva a
	   crecer de más, y como el recorte es más apaisado que la foto, el
	   ajuste siempre recorta arriba y abajo, nunca a los lados (que es
	   donde viven Bernardo y el nombre). */
	.mhero{ position:relative; width:100%; aspect-ratio:16/9; max-height:100vh; overflow:hidden; }
	/* Fuente 855x641 (4:3). Como el marco es más apaisado que la foto, el
	   ajuste recorta arriba y abajo: el 25% deja los ojos sobre la línea de
	   tercios superior en vez de al medio. */
	.mhero img{ width:100%; height:100%; object-fit:cover; object-position:50% 25%; display:block; }
	.mhero-scrim{ position:absolute; inset:0; z-index:1;
		background:linear-gradient(270deg, rgba(0,0,0,.5) 0%, rgba(0,0,0,.26) 32%, rgba(0,0,0,0) 60%); }
	/* El borde derecho del nombre cae en el mismo margen que el header, así
	   el wordmark, el link de volver y el nombre comparten retícula. Y va
	   bajo el centro: la cara pesa arriba a la izquierda, el nombre abajo a
	   la derecha, y la composición queda en diagonal en vez de enfrentada. */
	/* El borde izquierdo del bloque se fija en 58%: Bernardo termina cerca del
	   56% del encuadre, así que el nombre no puede alcanzarlo por más que
	   crezca la tipografía. Si no cabe, parte de línea dentro de su caja en
	   vez de invadirlo. */
	.mhero-overlay{ position:absolute; z-index:2; top:50%; transform:translateY(-50%);
		left:60%; right:clamp(1.2rem,4vw,3rem); text-align:right; }
	/* La referencia trackea los titulares en negativo (-0.02em) y aprieta el
	   interlineado a ~1.06 cuanto mas grande es el titular. */
	.mhero-overlay .word{ display:block; font-family:Georgia,'Times New Roman',serif; font-weight:400;
		font-size:clamp(1.9rem,4.2vw,3.85rem); line-height:1.06; letter-spacing:-.02em; color:#fff;
		text-shadow:0 1px 14px rgba(0,0,0,.35); }
	/* En bloque para que "Model" caiga siempre a su propia línea: si no, en
	   pantallas muy anchas el nombre entero entra en una sola y cambia la
	   composición. */
	.mhero-overlay .word em{ display:block; font-style:italic; color:rgba(255,255,255,.72); }

	.hero-caption{ text-align:center; font-family:Georgia,'Times New Roman',serif; font-weight:400;
		font-size:clamp(1rem,1.35vw,1.2rem); letter-spacing:.06em; color:var(--mi);
		margin:0; padding:clamp(1.3rem,3vw,2rem) clamp(1.2rem,4vw,3rem) 0; }

	/* En vertical no hay lugar para poner el nombre al lado sin pisarlo:
	   la foto se queda con él y el nombre pasa a la línea de abajo. */
	@media (max-width:760px){
		.mhero{ aspect-ratio:4/5; }
		/* En vertical el recorte pasa a ser lateral: el 15% mantiene a
		   Bernardo completo, de hombro a manos. */
		.mhero img{ object-position:15% 40%; }
		.mhero-scrim{ display:none; }
		.mhero-overlay{ position:static; transform:none; max-width:none; text-align:center;
			padding:clamp(1.2rem,4vw,2rem) clamp(1.2rem,4vw,3rem) 0; }
		.mhero-overlay .word{ color:var(--mi); text-shadow:none; }
		.mhero-overlay .word em{ color:var(--mm); }
		.hero-caption{ padding-top:.5rem; }
	}

	/* Aire generoso entre fotos y entre secciones: es lo que da la lectura
	   de revista que pidió Bernardo. */
	.mgallery{ padding:clamp(2.6rem,7vw,5rem) clamp(1.4rem,5vw,4rem); }
	.mgallery h2{ font-family:Georgia,'Times New Roman',serif; font-weight:400; font-style:italic;
		font-size:1.45rem; letter-spacing:-.02em; line-height:1.11; margin:0 0 clamp(1.4rem,3vw,2.2rem); color:var(--mm); }

	.grid-12{ display:grid; grid-template-columns:1fr; gap:clamp(1.6rem,5vw,4rem); }
	@media (min-width:600px){ .grid-12{ grid-template-columns:repeat(2,1fr); } }
	.grid-12 .photo{ aspect-ratio:4/5; overflow:hidden; }
	.grid-12 .photo img{ width:100%; height:100%; object-fit:cover; display:block; }

	.book-cta{ text-align:center; padding-top:clamp(1.4rem,3vw,2rem); }
	.book-cta a{ display:inline-block; color:var(--mi); text-decoration:none; font-size:.8rem;
		letter-spacing:.08em; text-transform:uppercase; border:1px solid var(--ml); padding:.75rem 1.6rem; }

	.identity{ max-width:62ch; margin:0 auto; padding:clamp(2.4rem,6vw,4rem) clamp(1.2rem,4vw,3rem); }
	.identity p{ font-size:1.1rem; line-height:1.8; }

	.work-list{ display:flex; flex-direction:column; gap:clamp(2.2rem,5vw,3.2rem); }
	.work-head{ display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:.4rem 1rem;
		margin-bottom:1rem; border-bottom:1px solid var(--ml); padding-bottom:.6rem; }
	.work-name{ font-family:Georgia,'Times New Roman',serif; font-size:1.15rem; letter-spacing:.03em; }
	.work-detalle{ font-size:.75rem; letter-spacing:.05em; color:var(--mm); text-transform:uppercase; }
	.grid-work{ display:grid; grid-template-columns:repeat(2,1fr); gap:clamp(1.2rem,3.5vw,2.4rem); }
	@media (min-width:820px){ .grid-work{ grid-template-columns:repeat(4,1fr); } }
	.grid-work .photo{ aspect-ratio:3/4; overflow:hidden; }
	.grid-work .photo img{ width:100%; height:100%; object-fit:cover; display:block; }

	/* Franja de Motion: el reel corre de fondo, en silencio y en bucle, y
	   encima van el título y los dos accesos. */
	.motion{ position:relative; width:100%; aspect-ratio:21/9; min-height:340px; max-height:70vh;
		overflow:hidden; background:#0b0b0a; display:grid; place-items:center; }
	.motion-video{ position:absolute; inset:0; overflow:hidden; }
	/* El iframe llega en 16/9 y la franja es más apaisada: se sobredimensiona
	   y se centra para que cubra sin barras negras. */
	.motion-video iframe{ position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
		width:100vw; height:56.25vw; min-height:100%; min-width:177.78vh;
		border:0; pointer-events:none; }
	.motion-scrim{ position:absolute; inset:0; background:rgba(0,0,0,.42); }
	.motion-contenido{ position:relative; z-index:2; text-align:center;
		padding:clamp(1.4rem,4vw,3rem); }
	.motion-contenido h2{ font-family:Georgia,'Times New Roman',serif; font-weight:400; font-style:italic;
		font-size:clamp(1.5rem,3vw,2.4rem); letter-spacing:-.02em; line-height:1.1;
		margin:0 0 clamp(1.2rem,2.5vw,1.8rem); color:#fff; text-shadow:0 1px 14px rgba(0,0,0,.4); }
	.motion-acciones{ display:flex; gap:clamp(.7rem,2vw,1.2rem); justify-content:center; flex-wrap:wrap; }
	.btn{ display:inline-block; min-width:9.5rem; padding:.85rem 1.8rem;
		border:1px solid rgba(255,255,255,.75); color:#fff; text-decoration:none;
		font-size:.82rem; letter-spacing:.14em; text-transform:uppercase;
		transition:background-color .2s ease, color .2s ease; }
	.btn:hover, .btn:focus-visible{ background:#fff; color:#111110; }

	/* Control de pausa: cualquier cosa que se mueva sola y dure más de cinco
	   segundos necesita una forma visible de detenerla (WCAG 2.2.2). La
	   preferencia de menos movimiento no lo reemplaza, porque sólo cubre a
	   quien la tenga configurada. */
	.motion-pausa{ position:absolute; z-index:3; right:.8rem; bottom:.8rem;
		background:rgba(0,0,0,.45); border:1px solid rgba(255,255,255,.45); color:#fff;
		font-size:.68rem; letter-spacing:.1em; text-transform:uppercase;
		padding:.45rem .8rem; cursor:pointer; }
	.motion-pausa:hover, .motion-pausa:focus-visible{ background:rgba(0,0,0,.7); }

	/* Visor a tamaño completo */
	button.photo{ display:block; width:100%; padding:0; border:0; background:none;
		cursor:zoom-in; font:inherit; color:inherit; }
	button.photo:focus-visible{ outline:2px solid var(--mi); outline-offset:3px; }

	.visor{ width:100vw; max-width:100vw; height:100dvh; max-height:100dvh;
		margin:0; padding:0; border:0; background:rgba(10,10,9,.96); overflow:hidden; }
	.visor::backdrop{ background:rgba(10,10,9,.9); }
	.visor-img{ position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
		max-width:92vw; max-height:88dvh; width:auto; height:auto; display:block; }
	.visor-btn{ position:absolute; z-index:2; background:none; border:0; color:#fff;
		cursor:pointer; line-height:1; padding:.6rem .9rem; opacity:.75; }
	.visor-btn:hover, .visor-btn:focus-visible{ opacity:1; }
	.visor-cerrar{ top:.7rem; right:.9rem; font-size:1.5rem; }
	.visor-prev, .visor-next{ top:50%; transform:translateY(-50%); font-size:2.6rem; }
	.visor-prev{ left:.4rem; }
	.visor-next{ right:.4rem; }
	.visor-pie{ position:absolute; left:0; right:0; bottom:.9rem; margin:0; text-align:center;
		font-size:.8rem; letter-spacing:.04em; color:rgba(255,255,255,.62); padding:0 3.5rem; }

	.grid-polaroids{ display:grid; grid-template-columns:repeat(2,1fr); gap:clamp(1.2rem,3.5vw,2.4rem); }
	@media (min-width:640px){ .grid-polaroids{ grid-template-columns:repeat(4,1fr); } }
	.grid-polaroids .photo{ aspect-ratio:1/1; overflow:hidden; }
	.grid-polaroids .photo img{ width:100%; height:100%; object-fit:cover; display:block; }

