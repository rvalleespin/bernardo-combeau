---
export const prerender = true;

import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ModeloHeader from '../../components/modelo/ModeloHeader.astro';
import Visor from '../../components/modelo/Visor.astro';
// Cada sección de la página es un archivo propio, y en el panel es una
// entrada propia dentro de "Modelo". Antes era un solo modelo.json con todo
// adentro, que en el panel se veía como un formulario interminable.
import portada from '../../data/modelo/portada.json';
import galeriaData from '../../data/modelo/galeria.json';
import identityData from '../../data/modelo/identity.json';
import selectedWorkData from '../../data/modelo/selected-work.json';
import motion from '../../data/modelo/motion.json';
import polaroidsData from '../../data/modelo/polaroids.json';
import booking from '../../data/modelo/booking.json';
import contacto from '../../data/contacto.json';
import nav from '../../data/nav.json';
// Motion y Commercials son páginas propias (/modelo/motion, /modelo/commercials),
// no secciones de esta portada — la lógica y el menú compartido viven en
// src/lib/modelo.js para no duplicarlos entre las tres páginas.
import { parseReel, motionFotos, comerciales, detailGroups, secciones, conVisor, encuadreStyle } from '../../lib/modelo.js';

const { heroFoto, heroCaption } = portada;
const galeria = galeriaData.fotos;
const identity = identityData.texto;
const selectedWork = selectedWorkData.trabajos;
const polaroids = polaroidsData.fotos;
const { titulo: motionTitulo, reelUrl, videoFondoUrl, poster: motionPoster } = motion;

const reel = parseReel(reelUrl);

// El reel de verdad: con controles y con sonido, en su proporcion nativa.
const reelEmbed = !reel
	? null
	: reel.tipo === 'youtube'
		? `https://www.youtube-nocookie.com/embed/${reel.id}?rel=0&playsinline=1&iv_load_policy=3`
		: `https://player.vimeo.com/video/${reel.id}?${reel.hash ? `h=${reel.hash}&` : ''}dnt=1&playsinline=1`;

// Respaldo para la franja cuando todavia no hay mp4 propio: el mismo reel, en
// silencio y en bucle. Recortado a 21/9 corta cabeza y pies, asi que es el
// plan B, no el plan A.
const reelFondo = !reel
	? null
	: reel.tipo === 'youtube'
		? `https://www.youtube-nocookie.com/embed/${reel.id}?autoplay=1&mute=1&loop=1&playlist=${reel.id}&controls=0&playsinline=1&disablekb=1&fs=0&iv_load_policy=3`
		: `https://player.vimeo.com/video/${reel.id}?${reel.hash ? `h=${reel.hash}&` : ''}background=1&autopause=0&dnt=1`;

// La franja aparece solo si hay algo que mostrar: mp4 propio o reel.
const hayFranja = Boolean(videoFondoUrl || reelFondo);

const motionPosterSrc = motionPoster
	? (await getImage({ src: motionPoster, width: 1920, quality: 70 })).src
	: null;

const galeriaV = await conVisor(galeria);
const polaroidsV = await conVisor(polaroids);
const selectedV = await Promise.all((selectedWork || []).map(async (job) => ({
	...job, fotos: await conVisor(job.fotos),
})));

// La linea meta se parte en sus items para que el quiebre en movil caiga
// siempre en un separador y nunca dentro de "185 cm" o "Grey Hair".
const metaItems = (heroCaption || '').split('\u00b7').map((t) => t.trim()).filter(Boolean);

const whatsappDigits = (contacto.whatsapp || '').replace(/\D/g, '');

// Mientras el titulo del menu este vacio la pagina esta "en obra": no se
// anuncia en el sitio y tampoco se ofrece a buscadores. Sacarla del menu no
// alcanza, porque igual entra al sitemap y se indexa.
const enObra = !(nav.modelo && nav.modelo.trim());

---

<Layout title="Bernardo Combeau — Model" description="Bernardo Combeau, model based in Santiago, Chile — fashion, commercial, e-commerce and advertising." image={heroFoto || undefined} noindex={enObra}>
	<div class="modelo">
		<ModeloHeader secciones={secciones} />

		{/* El nombre ya vive en el encabezado: repetirlo encima de la foto la
		    tapaba sin agregar nada. */}
		{heroFoto && (
			<div class="mhero">
				<Image src={heroFoto} alt="Bernardo Combeau" width={1920} quality={82} loading="eager" fetchpriority="high" />
			</div>
		)}

		{metaItems.length > 0 && (
			<p class="hero-caption">
				{metaItems.map((item, n) => (
					<>
						<span class="meta-item">{item}{n < metaItems.length - 1 && <i class="meta-sep" aria-hidden="true">·</i>}</span>
						{/* El separador viaja DENTRO del item para que nunca quede huerfano
						    al inicio de una linea, y el <wbr> pone el unico punto de quiebre
						    posible: entre items. Sin el, la fila entera es una sola palabra
						    y desborda a lo ancho en vez de partirse. */}
						{n < metaItems.length - 1 && <wbr />}
					</>
				))}
			</p>
		)}

		{galeria && galeria.length > 0 && (
			<section class="mgallery mgallery-book" id="book">
				{/* Se muestran 4 y el resto queda plegado detrás de "Full book". El
				    recorte lo pone el script, así que sin JavaScript se ven todas en
				    vez de quedar inalcanzables. */}
				<div class="grid-12" data-visor-grupo data-plegable={galeriaV.length > 4 ? '' : undefined}>
					{galeriaV.slice(0, 12).map((img, n) => (
						<button class="photo" type="button" aria-haspopup="dialog" data-extra={n >= 4 ? '' : undefined}
							data-lb={JSON.stringify(img.lb)} data-alt={img.alt || 'Bernardo Combeau'}>
							{/* El 4/5 recorta poco arriba y abajo, pero igual puede cortar
							    cabeza en una foto donde el sujeto queda muy arriba en el
							    encuadre original. Mismo mecanismo que Polaroids. */}
							<Image src={img.src} alt={img.alt || 'Bernardo Combeau'} width={1200} quality={80}
								style={encuadreStyle(img)} />
						</button>
					))}
				</div>
				{galeriaV.length > 4 && (
					<div class="book-cta">
						<button class="btn-book" type="button" aria-expanded="false" hidden>Full book</button>
					</div>
				)}
			</section>
		)}

		{identity && (
			<div class="identity"><p>{identity}</p></div>
		)}

		{selectedWork && selectedWork.length > 0 && (
			<section class="work" id="work">
				<h2>Selected Work</h2>
				<div class="work-list">
					{selectedV.map((job) => (
						<article class="work-item">
							<div class="work-head">
								<p class="work-name">{job.nombre}</p>
								{job.detalle && <p class="work-detalle">{job.detalle}</p>}
							</div>
							{/* Se ve una sola foto por campaña; el resto vive en el DOM sin
							    mostrarse, para que el visor las recorra al abrir. Asi el nombre
							    de la campaña se lee como titulo y no como una foto mas, y el
							    book de arriba sigue siendo la unica grilla de la pagina. */}
							<div class="work-fotos" data-visor-grupo>
								{(job.fotos || []).map((img, n) => (
									<button class="photo" type="button" aria-haspopup="dialog" data-oculta={n > 0 ? '' : undefined}
										data-lb={JSON.stringify(img.lb)} data-alt={img.alt || job.nombre}>
										{/* Solo la portada (n=0) se ve recortada — el resto vive oculta
										    para el visor, que muestra la foto completa sin recorte. */}
										<Image src={img.src} alt={img.alt || job.nombre} width={1920} quality={82}
											style={encuadreStyle(img)} />
									</button>
								))}
							</div>
							{(job.fotos || []).length > 1 && (
								<p class="work-cuenta">{job.fotos.length} photos</p>
							)}
						</article>
					))}
				</div>
			</section>
		)}

		{hayFranja && (
			<section class="motion" id="motion" aria-labelledby="motion-titulo"
				style={motionPosterSrc ? `background-image:url(${motionPosterSrc})` : undefined}>
				<div class="motion-media" aria-hidden="true">
					{/* El src lo pone el script, nunca el HTML: asi no se descarga si el
					    visitante pidio menos movimiento ni en pantallas chicas, y el boton
					    de pausa puede cortarlo de verdad en vez de solo taparlo. */}
					{videoFondoUrl ? (
						<video class="motion-video" data-src={videoFondoUrl}
							muted loop playsinline preload="none" tabindex="-1"
							poster={motionPosterSrc || undefined}></video>
					) : (
						<iframe class="motion-embed" data-src={reelFondo} title="" tabindex="-1"
							frameborder="0" allow="autoplay; picture-in-picture"></iframe>
					)}
				</div>
				<div class="motion-scrim"></div>
				<div class="motion-contenido">
					{/* El título repetía lo mismo que ya dicen los botones ("Motion",
					    "Commercials") una línea más abajo — se saca visualmente. Sigue
					    en el DOM (oculto, mismo truco que .visor-sr) para que un lector
					    de pantalla anuncie de qué trata la sección. */}
					<h2 id="motion-titulo" class="sr-only">{motionTitulo || 'Motion / Commercials'}</h2>
					{/* Dos accesos separados, cada uno solo si tiene contenido real —
					    ahora a páginas propias (/modelo/motion, /modelo/commercials),
					    no a anclas de esta misma página. "Stills" se sacó: ya no hace
					    falta, Book y Work tienen su propio link en el menú de arriba. */}
					<div class="motion-acciones">
						{motionFotos.length > 0 && <a class="btn" href="/modelo/motion">Motion</a>}
						{comerciales.length > 0 && <a class="btn" href="/modelo/commercials">Commercials</a>}
					</div>
				</div>
				<button class="motion-pausa" type="button" hidden>Pause</button>
			</section>
		)}

		{reelEmbed && (
			<section class="reel" id="reel" aria-labelledby="reel-titulo">
				<h2 id="reel-titulo">Reel</h2>
				{/* En su proporcion nativa y con controles: la franja de arriba es
				    decorativa y va recortada, esta es la pieza que se mira de verdad. */}
				<div class="reel-marco">
					<iframe data-src={reelEmbed} title="Reel — Bernardo Combeau" frameborder="0"
						allow="fullscreen; picture-in-picture" allowfullscreen></iframe>
				</div>
				<noscript>
					<p class="reel-alt"><a href={reelUrl} target="_blank" rel="noopener">Watch the full reel →</a></p>
				</noscript>
			</section>
		)}

		{polaroids && polaroids.length > 0 && (
			<section class="mgallery" id="polaroids">
				<h2>Polaroids</h2>
				<div class="grid-polaroids" data-visor-grupo>
					{polaroidsV.slice(0, 4).map((img) => (
						<button class="photo" type="button" aria-haspopup="dialog"
							data-lb={JSON.stringify(img.lb)} data-alt={img.alt || 'Bernardo Combeau'}>
							{/* El cuadrado recorta arriba y abajo. Con "posicion" se elige qué
							    parte se conserva, para que no quede cortada la cabeza. */}
							<Image src={img.src} alt={img.alt || 'Bernardo Combeau'} width={640} quality={80}
								style={encuadreStyle(img)} />
						</button>
					))}
				</div>
			</section>
		)}

		{/* Details y Booking comparten fila desde tablet: Details solo no llenaba
		    el ancho (va left-aligned) y dejaba un vacío a la derecha. */}
		<div class="details-booking">
			{detailGroups.length > 0 && (
				<section class="stats" id="details">
					<h2>Details</h2>
					<div class="stat-cols">
						{detailGroups.map((group) => (
							<dl class="stat-col">
								{group.map(([label, value]) => (
									<div class="stat">
										<dt>{label}</dt>
										<dd>{value}</dd>
									</div>
								))}
							</dl>
						))}
					</div>
				</section>
			)}

			<footer class="mfoot" id="booking">
				<h2>Booking</h2>
				{booking?.region && <p class="region">{booking.region}</p>}
				<div class="contact-links">
					{contacto.email && <a href={`mailto:${contacto.email}`}>{contacto.email}</a>}
					{whatsappDigits && <a href={`https://wa.me/${whatsappDigits}`} target="_blank" rel="noopener">{contacto.whatsapp}</a>}
					{booking?.instagram && <a href={`https://instagram.com/${booking.instagram.replace(/^@/, '')}`} target="_blank" rel="noopener">{booking.instagram}</a>}
				</div>
				<a class="back" href="/">← Photography</a>
			</footer>
		</div>

		<Visor />
	</div>
</Layout>

<script>
	// ---- Book: se muestran 4 y el resto se despliega ------------------------
	// El recorte lo aplica el script, no el HTML: si el JavaScript no corre, la
	// grilla queda completa en vez de dejar fotos inalcanzables detrás de un
	// botón muerto.
	const grillaBook = document.querySelector('.grid-12[data-plegable]');
	const btnBook = document.querySelector('.btn-book');
	if (grillaBook && btnBook) {
		const extras = grillaBook.querySelectorAll('.photo[data-extra]');
		grillaBook.setAttribute('data-recortado', '');
		btnBook.hidden = false;
		btnBook.addEventListener('click', () => {
			const plegado = grillaBook.hasAttribute('data-recortado');
			if (plegado) {
				grillaBook.removeAttribute('data-recortado');
				btnBook.textContent = 'Show less';
				btnBook.setAttribute('aria-expanded', 'true');
				// El foco salta a la primera foto recién revelada para que quien
				// navega con teclado no quede parado antes de ellas.
				if (extras[0]) extras[0].focus({ preventScroll: true });
			} else {
				grillaBook.setAttribute('data-recortado', '');
				btnBook.textContent = 'Full book';
				btnBook.setAttribute('aria-expanded', 'false');
				btnBook.scrollIntoView({ block: 'center' });
			}
		});
	}

	// ---- Franja de Motion ----------------------------------------------------
	// El fondo se monta desde aca y no desde el HTML: si el visitante pidio menos
	// movimiento no se carga nunca (un iframe de plataforma ignora esa preferencia
	// por su cuenta), en movil no se sirve video decorativo, y el boton de pausa
	// puede cortarlo de verdad quitandole el src.
	const banda = document.querySelector('.motion');
	if (banda) {
		const vid = banda.querySelector('video.motion-video');
		const marco = banda.querySelector('iframe.motion-embed');
		const medio = vid || marco;
		const btn = banda.querySelector('.motion-pausa');
		const fuente = medio && medio.dataset.src;
		const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
		// Como la referencia: en pantallas chicas manda el poster, no el video.
		// Ahi el autoplay es menos confiable y el loop es puro adorno pagado con
		// datos del visitante.
		const pantallaGrande = window.matchMedia('(min-width: 768px)');
		const ahorroDatos = navigator.connection && navigator.connection.saveData;
		let corriendo = false;

		const rotular = () => { btn.textContent = corriendo ? 'Pause' : 'Play'; };

		const encender = () => {
			if (corriendo || !fuente) return;
			if (vid) {
				if (!vid.src) vid.src = fuente;
				vid.muted = true;
				const p = vid.play();
				// Nunca dar por hecho el autoplay: el modo de bajo consumo de iOS lo
				// bloquea aun con muted + playsinline, y no es detectable. Si falla,
				// se queda el poster y no se insiste.
				if (p && p.catch) p.catch(() => { corriendo = false; rotular(); });
			} else if (!marco.src) {
				marco.src = fuente;
			}
			corriendo = true;
			rotular();
		};

		const apagar = () => {
			if (!corriendo) return;
			if (vid) vid.pause();
			else marco.removeAttribute('src');
			corriendo = false;
			rotular();
		};

		if (fuente && pantallaGrande.matches && !menosMovimiento.matches && !ahorroDatos) {
			btn.hidden = false;
			rotular();
			if ('IntersectionObserver' in window) {
				// No cargar nada hasta que la franja este por entrar en pantalla.
				const obs = new IntersectionObserver((entradas) => {
					entradas.forEach((e) => { if (e.isIntersecting) { encender(); obs.disconnect(); } });
				}, { rootMargin: '250px' });
				obs.observe(banda);
			} else {
				encender();
			}
			btn.addEventListener('click', () => { corriendo ? apagar() : encender(); });
		}
	}

	// ---- Reel completo -------------------------------------------------------
	// Mismo criterio: el reproductor pesado no se monta hasta que hace falta.
	const reelMarco = document.querySelector('.reel-marco iframe');
	if (reelMarco && reelMarco.dataset.src) {
		const montar = () => { if (!reelMarco.src) reelMarco.src = reelMarco.dataset.src; };
		if ('IntersectionObserver' in window) {
			const obs = new IntersectionObserver((entradas) => {
				entradas.forEach((e) => { if (e.isIntersecting) { montar(); obs.disconnect(); } });
			}, { rootMargin: '300px' });
			obs.observe(reelMarco);
		} else { montar(); }
	}

</script>

<style>
	.modelo{ --mp: #ffffff; --mi: #111110; --mm: #84817a; --ml: #e7e4dd;
		background:var(--mp); color:var(--mi); font-family:-apple-system,BlinkMacSystemFont,sans-serif; }

	/* El encabezado es fijo (ver ModeloHeader.astro), así que al saltar a una
	   sección hay que dejarle
	   su alto libre o el título queda tapado detrás de la barra. */
	:target{ scroll-margin-top:6.5rem; }
	.modelo section, .modelo footer{ scroll-margin-top:6.5rem; }

	.mhero{ position:relative; width:100%; aspect-ratio:16/9; max-height:100vh; overflow:hidden; }
	/* Fuente 855x641 (4:3). Como el marco es más apaisado que la foto, el
	   ajuste recorta arriba y abajo: el 25% deja los ojos sobre la línea de
	   tercios superior en vez de al medio. */
	.mhero img{ width:100%; height:100%; object-fit:cover; object-position:50% 25%; display:block; }

	/* Linea meta. Los sitios de modelo reales la dejan entre 16 y 20px SIEMPRE,
	   sin importar cuanto mida el nombre: por eso va en px absolutos y no como
	   fraccion del titular (atada al nombre en em, en movil vuelve a caer a
	   12-13px y reaparece el problema que reporto Bernardo). Piso 17px.
	   El tracking baja de .06em a .03em: a este tamano un tracking ancho se lee
	   como letra chica legal, y era parte de por que la linea se perdia. */
	.hero-caption{ text-align:center; font-family:Georgia,'Times New Roman',serif; font-weight:400;
		font-size:clamp(1.0625rem,1.25vw,1.1875rem); letter-spacing:.03em; line-height:1.55;
		color:var(--mi); text-wrap:balance;
		margin:0; padding:clamp(1.3rem,3vw,2rem) clamp(1.2rem,4vw,3rem) 0; }
	/* Cada dato es indivisible: si la linea quiebra en movil, quiebra en un
	   separador y nunca dentro de "185 cm" o "Grey Hair". */
	.meta-item{ white-space:nowrap; }
	.meta-sep{ font-style:normal; color:var(--mm); margin:0 .5em; }

	@media (max-width:760px){
		.mhero{ aspect-ratio:4/5; }
		/* En vertical el recorte pasa a ser lateral: el 15% mantiene a
		   Bernardo completo, de hombro a manos. */
		.mhero img{ object-position:15% 40%; }
		.hero-caption{ padding-top:1rem; }
		:target, .modelo section, .modelo footer{ scroll-margin-top:8.5rem; }
	}

	/* Aire generoso entre fotos y entre secciones: es lo que da la lectura
	   de revista que pidió Bernardo. */
	.mgallery{ padding:clamp(2.6rem,7vw,5rem) clamp(1.4rem,5vw,4rem); }
	.mgallery-book{ padding-bottom:clamp(1.3rem,3.5vw,2.5rem); }
	.mgallery h2{ font-family:Georgia,'Times New Roman',serif; font-weight:400; font-style:italic;
		font-size:1.45rem; letter-spacing:-.02em; line-height:1.11; margin:0 0 clamp(1.4rem,3vw,2.2rem); color:var(--mm); }

	.grid-12{ display:grid; grid-template-columns:1fr; gap:clamp(1.6rem,5vw,4rem); }
	@media (min-width:600px){ .grid-12{ grid-template-columns:repeat(2,1fr); } }
	.grid-12 .photo{ aspect-ratio:4/5; overflow:hidden; }
	.grid-12 .photo img{ width:100%; height:100%; object-fit:cover; display:block; }

	/* Sin JavaScript no se pone data-recortado y se ven todas: el boton solo
	   aparece si el script pudo tomar el control. */
	.grid-12[data-recortado] .photo[data-extra]{ display:none; }
	.book-cta{ text-align:center; padding-top:clamp(1.4rem,3vw,2rem); }
	.btn-book{ display:inline-block; background:none; cursor:pointer;
		color:var(--mi); font:inherit; font-size:.72rem; letter-spacing:.16em;
		text-transform:uppercase; border:1px solid var(--mi); padding:.8rem 2rem;
		transition:background-color .2s ease, color .2s ease; }
	.btn-book:hover, .btn-book:focus-visible{ background:var(--mi); color:var(--mp); }
	.book-cta a{ display:inline-block; color:var(--mi); text-decoration:none; font-size:.8rem;
		letter-spacing:.08em; text-transform:uppercase; border:1px solid var(--ml); padding:.75rem 1.6rem; }

	/* Bernardo pidio la mitad del aire entre Full book, este texto y Selected
	   Work. El hueco lo forman dos paddings que se suman, asi que se reducen
	   los dos: este y el de arriba de la seccion siguiente. */
	.identity{ max-width:62ch; margin:0 auto; padding:clamp(1.2rem,3vw,2rem) clamp(1.2rem,4vw,3rem); }
	.identity p{ font-size:1.1rem; line-height:1.8; }

	/* Selected Work se separa del book por GEOMETRIA, no por color: las
	   agencias reales (IMG, Next, Premier, Ford, Viva) mantienen el fondo
	   blanco y cambian ancho y gutter. El book va contenido y con aire; la
	   campaña va a sangre completa y sin gutter. */
	.work{ padding:clamp(2.6rem,6vw,4.5rem) 0; }
	.work > h2{ font-family:Georgia,'Times New Roman',serif; font-weight:400; font-style:italic;
		font-size:1.45rem; letter-spacing:-.02em; line-height:1.11; color:var(--mm);
		margin:0 clamp(1.4rem,5vw,4rem) clamp(1.8rem,4vw,2.6rem); }
	.work-list{ display:flex; flex-direction:column; gap:clamp(2.6rem,6vw,4.5rem); }

	/* El nombre de campaña va chico, en mayusculas y centrado sobre la foto.
	   Es lo que hacen todas las fichas revisadas: nunca un titular grande, y
	   con tracking neutro o positivo, no el negativo de los titulares serif.
	   La jerarquia con la bajada se hace por peso, no por tamaño. */
	.work-head{ text-align:center; padding:0 clamp(1.4rem,5vw,4rem);
		margin-bottom:clamp(.9rem,2vw,1.4rem); }
	.work-name{ font-size:.78rem; font-weight:600; letter-spacing:.16em; text-transform:uppercase;
