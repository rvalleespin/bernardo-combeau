---
export const prerender = true;

import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import modelo from '../../data/modelo.json';
import contacto from '../../data/contacto.json';

const { heroFoto, heroCaption, galeria, identity, selectedWork,
	reelUrl, videoFondoUrl, motionPoster, motionTitulo,
	polaroids, details, booking } = modelo;

// Ni el reel ni el loop de fondo se suben al repo: Git no es lugar para video
// pesado. El reel vive en YouTube/Vimeo; el loop de fondo es un mp4 alojado
// fuera (Vercel Blob, R2, Bunny) y referenciado por URL.
function parseReel(url) {
	if (!url) return null;
	const yt = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/))([\w-]+)/);
	if (yt) return { tipo: 'youtube', id: yt[1] };
	// El hash de privacidad de Vimeo es parte del identificador: sin el, un
	// video no listado (lo normal en este rubro) responde "does not exist".
	const vimeo = url.match(/vimeo\.com\/(?:video\/)?(\d+)(?:\/([0-9a-zA-Z]+))?/);
	if (vimeo) {
		const h = url.match(/[?&]h=([0-9a-zA-Z]+)/);
		return { tipo: 'vimeo', id: vimeo[1], hash: vimeo[2] || (h ? h[1] : null) };
	}
	return null;
}

const reel = parseReel(reelUrl);

// El reel de verdad: con controles y con sonido, en su proporcion nativa.
const reelEmbed = !reel
	? null
	: reel.tipo === 'youtube'
		? `https://www.youtube-nocookie.com/embed/${reel.id}?rel=0&playsinline=1&iv_load_policy=3`
		: `https://player.vimeo.com/video/${reel.id}?${reel.hash ? `h=${reel.hash}&` : ''}dnt=1&playsinline=1`;

// Respaldo para la franja cuando todavia no hay mp4 propio: el mismo reel, en
// silencio y en bucle. Recortado a 21/9 corta cabeza y pies, asi que es el
// plan B, no el plan A.
const reelFondo = !reel
	? null
	: reel.tipo === 'youtube'
		? `https://www.youtube-nocookie.com/embed/${reel.id}?autoplay=1&mute=1&loop=1&playlist=${reel.id}&controls=0&playsinline=1&disablekb=1&fs=0&iv_load_policy=3`
		: `https://player.vimeo.com/video/${reel.id}?${reel.hash ? `h=${reel.hash}&` : ''}background=1&autopause=0&dnt=1`;

// La franja aparece solo si hay algo que mostrar: mp4 propio o reel.
const hayFranja = Boolean(videoFondoUrl || reelFondo);

const motionPosterSrc = motionPoster
	? (await getImage({ src: motionPoster, width: 1920, quality: 70 })).src
	: null;

// Anchos VALIDOS del optimizador de Vercel en este proyecto
// (.vercel/output/config.json -> images.sizes). Verificado en un build real:
// getImage() ajusta solo cualquier otro valor al mas cercano, y si se omite
// `quality` el adaptador pone q=100. Nunca armar la URL a mano: en `astro dev`
// el endpoint es otro (/_image?href=...) y daria 404 en local.
const LB_ANCHOS = [1200, 1920, 2048];

async function conVisor(fotos) {
	return Promise.all((fotos || []).map(async (f) => {
		const lb = {};
		for (const w of LB_ANCHOS) {
			lb[w] = (await getImage({ src: f.src, width: w, quality: 82 })).src;
		}
		return { ...f, lb };
	}));
}

const galeriaV = await conVisor(galeria);
const polaroidsV = await conVisor(polaroids);
const selectedV = await Promise.all((selectedWork || []).map(async (job) => ({
	...job, fotos: await conVisor(job.fotos),
})));

// La linea meta se parte en sus items para que el quiebre en movil caiga
// siempre en un separador y nunca dentro de "185 cm" o "Grey Hair".
const metaItems = (heroCaption || '').split('\u00b7').map((t) => t.trim()).filter(Boolean);

// Tres columnas, como pidio Bernardo: la altura sola, las tres medidas de
// cuerpo siempre juntas, y el resto de los rasgos aparte. Cada columna se
// cae sola si no tiene ningun dato cargado.
const detailGroups = [
	[['Height', details?.height]],
	[['Chest', details?.chest], ['Waist', details?.waist], ['Hips', details?.hips]],
	[['Shoes', details?.shoes], ['Hair', details?.hair], ['Eyes', details?.eyes]],
]
	.map((group) => group.filter(([, v]) => v))
	.filter((group) => group.length > 0);

const whatsappDigits = (contacto.whatsapp || '').replace(/\D/g, '');
---

<Layout title="Bernardo Combeau — Model" description="Bernardo Combeau, model based in Santiago, Chile — fashion, commercial, e-commerce and advertising." image={heroFoto || undefined}>
	<div class="modelo">
		<header class="mhead">
			<span class="wordmark">Bernardo Combeau</span>
			<a class="back" href="/">← Volver a fotografía</a>
		</header>

		{heroFoto && (
			<div class="mhero-wrap">
				<div class="mhero">
					<Image src={heroFoto} alt="Bernardo Combeau" width={1800} quality={82} loading="eager" fetchpriority="high" />
					<div class="mhero-scrim"></div>
				</div>
				<div class="mhero-overlay">
					<span class="word">Bernardo Combeau <em>Model</em></span>
				</div>
			</div>
		)}

		{metaItems.length > 0 && (
			<p class="hero-caption">
				{metaItems.map((item, n) => (
					<>
						<span class="meta-item">{item}{n < metaItems.length - 1 && <i class="meta-sep" aria-hidden="true">·</i>}</span>
						{/* El separador viaja DENTRO del item para que nunca quede huerfano
						    al inicio de una linea, y el <wbr> pone el unico punto de quiebre
						    posible: entre items. Sin el, la fila entera es una sola palabra
						    y desborda a lo ancho en vez de partirse. */}
						{n < metaItems.length - 1 && <wbr />}
					</>
				))}
			</p>
		)}

		{galeria && galeria.length > 0 && (
			<section class="mgallery" id="galeria">
				<div class="grid-12" data-visor-grupo>
					{galeriaV.slice(0, 12).map((img) => (
						<button class="photo" type="button" aria-haspopup="dialog"
							data-lb={JSON.stringify(img.lb)} data-alt={img.alt || 'Bernardo Combeau'}>
							<Image src={img.src} alt={img.alt || 'Bernardo Combeau'} width={1200} quality={80} />
						</button>
					))}
				</div>
				{selectedWork && selectedWork.length > 0 && (
					<div class="book-cta"><a href="#selected-work">Ver book completo →</a></div>
				)}
			</section>
		)}

		{identity && (
			<div class="identity"><p>{identity}</p></div>
		)}

		{selectedWork && selectedWork.length > 0 && (
			<section class="mgallery" id="selected-work">
				<h2>Selected Work</h2>
				<div class="work-list">
					{selectedV.map((job) => (
						<div class="work-item">
							<div class="work-head">
								<span class="work-name">{job.nombre}</span>
								{job.detalle && <span class="work-detalle">{job.detalle}</span>}
							</div>
							<div class="grid-work" data-visor-grupo>
								{(job.fotos || []).map((img) => (
									<button class="photo" type="button" aria-haspopup="dialog"
										data-lb={JSON.stringify(img.lb)} data-alt={img.alt || job.nombre}>
										<Image src={img.src} alt={img.alt || job.nombre} width={800} quality={80} />
									</button>
								))}
							</div>
						</div>
					))}
				</div>
			</section>
		)}

		{hayFranja && (
			<section class="motion" id="motion" aria-labelledby="motion-titulo"
				style={motionPosterSrc ? `background-image:url(${motionPosterSrc})` : undefined}>
				<div class="motion-media" aria-hidden="true">
					{/* El src lo pone el script, nunca el HTML: asi no se descarga si el
					    visitante pidio menos movimiento ni en pantallas chicas, y el boton
					    de pausa puede cortarlo de verdad en vez de solo taparlo. */}
					{videoFondoUrl ? (
						<video class="motion-video" data-src={videoFondoUrl}
							muted loop playsinline preload="none" tabindex="-1"
							poster={motionPosterSrc || undefined}></video>
					) : (
						<iframe class="motion-embed" data-src={reelFondo} title="" tabindex="-1"
							frameborder="0" allow="autoplay; picture-in-picture"></iframe>
					)}
				</div>
				<div class="motion-scrim"></div>
				<div class="motion-contenido">
					<h2 id="motion-titulo">{motionTitulo || 'Motion / Commercials'}</h2>
					<div class="motion-acciones">
						<a class="btn" href="#galeria">Stills</a>
						{reelEmbed && <a class="btn" href="#reel">Motion</a>}
					</div>
				</div>
				<button class="motion-pausa" type="button" hidden>Pausar</button>
			</section>
		)}

		{reelEmbed && (
			<section class="reel" id="reel" aria-labelledby="reel-titulo">
				<h2 id="reel-titulo">Reel</h2>
				{/* En su proporcion nativa y con controles: la franja de arriba es
				    decorativa y va recortada, esta es la pieza que se mira de verdad. */}
				<div class="reel-marco">
					<iframe data-src={reelEmbed} title="Reel — Bernardo Combeau" frameborder="0"
						allow="fullscreen; picture-in-picture" allowfullscreen></iframe>
				</div>
				<noscript>
					<p class="reel-alt"><a href={reelUrl} target="_blank" rel="noopener">Ver el reel completo →</a></p>
				</noscript>
			</section>
		)}

		{polaroids && polaroids.length > 0 && (
			<section class="mgallery">
				<h2>Polaroids</h2>
				<div class="grid-polaroids" data-visor-grupo>
					{polaroidsV.slice(0, 4).map((img) => (
						<button class="photo" type="button" aria-haspopup="dialog"
							data-lb={JSON.stringify(img.lb)} data-alt={img.alt || 'Bernardo Combeau'}>
							<Image src={img.src} alt={img.alt || 'Bernardo Combeau'} width={600} quality={80} />
						</button>
					))}
				</div>
			</section>
		)}

		{detailGroups.length > 0 && (
			<section class="stats">
				<h2>Details</h2>
				<div class="stat-cols">
					{detailGroups.map((group) => (
						<dl class="stat-col">
							{group.map(([label, value]) => (
								<div class="stat">
									<dt>{label}</dt>
									<dd>{value}</dd>
								</div>
							))}
						</dl>
					))}
				</div>
			</section>
		)}

		<footer class="mfoot">
			<h2>Booking</h2>
			{booking?.region && <p class="region">{booking.region}</p>}
			<div class="contact-links">
				{contacto.email && <a href={`mailto:${contacto.email}`}>{contacto.email}</a>}
				{whatsappDigits && <a href={`https://wa.me/${whatsappDigits}`} target="_blank" rel="noopener">{contacto.whatsapp}</a>}
				{booking?.instagram && <a href={`https://instagram.com/${booking.instagram.replace(/^@/, '')}`} target="_blank" rel="noopener">{booking.instagram}</a>}
			</div>
			<a class="back" href="/">← Volver a fotografía</a>
		</footer>

		<dialog class="visor" aria-label="Foto a tamaño completo">
			<figure class="visor-fig">
				<img class="visor-img" alt="" decoding="async" />
			</figure>
			{/* autofocus va en Cerrar a proposito: sin el, showModal() manda el foco
			    al primer focusable del DOM, que aca seria "Foto anterior". */}
			<button class="visor-btn visor-cerrar" type="button" autofocus aria-label="Cerrar visor">✕</button>
			<button class="visor-btn visor-prev" type="button" aria-label="Foto anterior">‹</button>
			<button class="visor-btn visor-next" type="button" aria-label="Foto siguiente">›</button>
			<p class="visor-pie" aria-hidden="true"></p>
			{/* Al navegar con las flechas cambia la imagen pero no se mueve el foco:
			    sin esta region viva un lector de pantalla no anuncia nada. */}
			<p class="visor-sr" role="status" aria-live="polite"></p>
		</dialog>
	</div>
</Layout>

<script>
	// ---- Franja de Motion ----------------------------------------------------
	// El fondo se monta desde aca y no desde el HTML: si el visitante pidio menos
	// movimiento no se carga nunca (un iframe de plataforma ignora esa preferencia
	// por su cuenta), en movil no se sirve video decorativo, y el boton de pausa
	// puede cortarlo de verdad quitandole el src.
	const banda = document.querySelector('.motion');
	if (banda) {
		const vid = banda.querySelector('video.motion-video');
		const marco = banda.querySelector('iframe.motion-embed');
		const medio = vid || marco;
		const btn = banda.querySelector('.motion-pausa');
		const fuente = medio && medio.dataset.src;
		const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
		// Como la referencia: en pantallas chicas manda el poster, no el video.
		// Ahi el autoplay es menos confiable y el loop es puro adorno pagado con
		// datos del visitante.
		const pantallaGrande = window.matchMedia('(min-width: 768px)');
		const ahorroDatos = navigator.connection && navigator.connection.saveData;
		let corriendo = false;

		const rotular = () => { btn.textContent = corriendo ? 'Pausar' : 'Reproducir'; };

		const encender = () => {
			if (corriendo || !fuente) return;
			if (vid) {
				if (!vid.src) vid.src = fuente;
				vid.muted = true;
				const p = vid.play();
				// Nunca dar por hecho el autoplay: el modo de bajo consumo de iOS lo
				// bloquea aun con muted + playsinline, y no es detectable. Si falla,
				// se queda el poster y no se insiste.
				if (p && p.catch) p.catch(() => { corriendo = false; rotular(); });
			} else if (!marco.src) {
				marco.src = fuente;
			}
			corriendo = true;
			rotular();
		};

		const apagar = () => {
			if (!corriendo) return;
			if (vid) vid.pause();
			else marco.removeAttribute('src');
			corriendo = false;
			rotular();
		};

		if (fuente && pantallaGrande.matches && !menosMovimiento.matches && !ahorroDatos) {
			btn.hidden = false;
			rotular();
			if ('IntersectionObserver' in window) {
				// No cargar nada hasta que la franja este por entrar en pantalla.
				const obs = new IntersectionObserver((entradas) => {
					entradas.forEach((e) => { if (e.isIntersecting) { encender(); obs.disconnect(); } });
				}, { rootMargin: '250px' });
				obs.observe(banda);
			} else {
				encender();
			}
			btn.addEventListener('click', () => { corriendo ? apagar() : encender(); });
		}
	}

	// ---- Reel completo -------------------------------------------------------
	// Mismo criterio: el reproductor pesado no se monta hasta que hace falta.
	const reelMarco = document.querySelector('.reel-marco iframe');
	if (reelMarco && reelMarco.dataset.src) {
		const montar = () => { if (!reelMarco.src) reelMarco.src = reelMarco.dataset.src; };
		if ('IntersectionObserver' in window) {
			const obs = new IntersectionObserver((entradas) => {
				entradas.forEach((e) => { if (e.isIntersecting) { montar(); obs.disconnect(); } });
			}, { rootMargin: '300px' });
			obs.observe(reelMarco);
		} else { montar(); }
	}

	// ---- Visor a tamano completo ---------------------------------------------
	// <dialog> + showModal(): el navegador ya da top layer, ::backdrop, el resto
	// del documento inerte, el foco atrapado y el cierre con Escape. No hace falta
	// libreria y NO hay que escribir un focus trap a mano.
	const dlg = document.querySelector('.visor');
	if (dlg) {
		const img = dlg.querySelector('.visor-img');
		const pie = dlg.querySelector('.visor-pie');
		const aviso = dlg.querySelector('.visor-sr');
		const prev = dlg.querySelector('.visor-prev');
		const next = dlg.querySelector('.visor-next');
		let grupo = [];
		let i = 0;
		let ancho = 1920;

		// El ancho se elige una vez al abrir. En un visor que hace "contain" con
		// fotos verticales manda el ALTO, no el ancho, por eso no se usa innerWidth
		// solo. El piso de 1200 cubre la pestaña en segundo plano, donde
		// innerWidth/innerHeight pueden llegar en 0.
		const elegirAncho = (set) => {
			const disp = Object.keys(set).map(Number).sort((a, b) => a - b);
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			const necesita = Math.max(1200, Math.min(window.innerWidth, Math.round(window.innerHeight * 1.25)) * dpr);
			return disp.find((w) => w >= necesita) || disp[disp.length - 1];
		};

		const urlDe = (boton) => {
			const set = JSON.parse(boton.dataset.lb);
			return set[ancho] || Object.values(set)[0];
		};

		const pintar = () => {
			const f = grupo[i];
			img.classList.remove('lista');
			img.src = urlDe(f);
			img.alt = f.dataset.alt || '';
			if (img.decode) img.decode().catch(() => {}).then(() => img.classList.add('lista'));
			else img.classList.add('lista');
			pie.textContent = f.dataset.alt || '';
			aviso.textContent = 'Foto ' + (i + 1) + ' de ' + grupo.length + '. ' + (f.dataset.alt || '');
			const varias = grupo.length > 1;
			prev.hidden = !varias;
			next.hidden = !varias;
			// Precarga los vecinos: la flecha se siente instantanea.
			if (varias) {
				[1, -1].forEach((d) => {
					const v = grupo[(i + d + grupo.length) % grupo.length];
					document.createElement('img').src = urlDe(v);
				});
			}
		};

		const mover = (paso) => { i = (i + paso + grupo.length) % grupo.length; pintar(); };

		document.addEventListener('click', (e) => {
			const b = e.target.closest('button.photo');
			if (!b) return;
			// Un grupo por grilla: sin esto las flechas saltan de la galeria a
			// Selected Work y de ahi a las polaroids en una sola lista corrida.
			const cont = b.closest('[data-visor-grupo]') || document;
			grupo = Array.from(cont.querySelectorAll('button.photo'));
			i = grupo.indexOf(b);
			ancho = elegirAncho(JSON.parse(b.dataset.lb));
			pintar();
			// showModal() NO bloquea el scroll del fondo.
			document.documentElement.classList.add('visor-abierto');
			dlg.showModal();
		});

		// Idempotente: da igual si ademas llega el evento 'close'.
		const cerrar = () => {
			if (dlg.open) dlg.close();
			img.removeAttribute('src');
			document.documentElement.classList.remove('visor-abierto');
			// El foco vuelve a la miniatura ACTUAL, no a la del clic original: si
			// abriste la 1 y navegaste hasta la 6, quedas parado en la 6.
			const destino = grupo[i];
			if (destino) {
				destino.focus({ preventScroll: true });
				destino.scrollIntoView({ block: 'center' });
			}
		};

		dlg.querySelector('.visor-cerrar').addEventListener('click', cerrar);
		prev.addEventListener('click', () => mover(-1));
		next.addEventListener('click', () => mover(1));

		dlg.addEventListener('keydown', (e) => {
			const acciones = {
				ArrowLeft: () => mover(-1),
				ArrowRight: () => mover(1),
				Home: () => mover(-i),
				End: () => mover(grupo.length - 1 - i),
			};
			const f = acciones[e.key];
			if (f) { e.preventDefault(); f(); }
		});

		// Clic en el fondo (fuera de la foto) cierra.
		dlg.addEventListener('click', (e) => {
			if (e.target === dlg || e.target === img.parentElement) cerrar();
		});
		// Escape lo maneja el navegador: se intercepta para que pase por la limpieza.
		dlg.addEventListener('cancel', (e) => { e.preventDefault(); cerrar(); });
		dlg.addEventListener('close', cerrar);

		// Gestos: deslizar al lado cambia de foto, deslizar hacia abajo cierra.
		// El filtro por dominancia evita que un scroll con el pulgar torcido
		// cambie de foto sin querer.
		let x0 = null;
		let y0 = null;
		dlg.addEventListener('pointerdown', (e) => {
			if (e.pointerType !== 'touch') return;
			x0 = e.clientX; y0 = e.clientY;
		});
		dlg.addEventListener('pointerup', (e) => {
			if (x0 === null) return;
			const dx = e.clientX - x0;
			const dy = e.clientY - y0;
			x0 = null;
			if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) mover(dx < 0 ? 1 : -1);
			else if (dy > 90 && Math.abs(dy) > Math.abs(dx) * 1.5) cerrar();
		});
	}
</script>

<style>
	.modelo{ --mp: #ffffff; --mi: #111110; --mm: #84817a; --ml: #e7e4dd;
		background:var(--mp); color:var(--mi); font-family:-apple-system,BlinkMacSystemFont,sans-serif; }
	/* Barra superior fija, como la referencia: el nombre vive acá arriba
	   además de ir sobre la foto. */
	.mhead{ position:sticky; top:0; z-index:10; background:var(--mp);
		display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.4rem 1.2rem;
		padding:1.1rem clamp(1.2rem,4vw,3rem); border-bottom:1px solid var(--ml); }
	.mhead .wordmark{ font-size:.9rem; font-weight:600; letter-spacing:.18em; text-transform:uppercase;
		color:var(--mi); }
	.mhead .back{ color:var(--mm); text-decoration:none; font-size:.8rem; }

	/* El hero es una banda apaisada recortada, no la foto entera a ancho
	   completo (así deja de salir gigante). El sujeto queda a la izquierda
	   del encuadre y el nombre cae sobre el fondo desenfocado de la derecha,
	   sin taparlo. */
	.mhero-wrap{ position:relative; }
	/* La referencia fija el hero en min-height:100vh. Acá se usa 16/9 con
	   tope de viewport: en pantallas anchas el tope evita que vuelva a
	   crecer de más, y como el recorte es más apaisado que la foto, el
	   ajuste siempre recorta arriba y abajo, nunca a los lados (que es
	   donde viven Bernardo y el nombre). */
	.mhero{ position:relative; width:100%; aspect-ratio:16/9; max-height:100vh; overflow:hidden; }
	/* Fuente 855x641 (4:3). Como el marco es más apaisado que la foto, el
	   ajuste recorta arriba y abajo: el 25% deja los ojos sobre la línea de
	   tercios superior en vez de al medio. */
	.mhero img{ width:100%; height:100%; object-fit:cover; object-position:50% 25%; display:block; }
	.mhero-scrim{ position:absolute; inset:0; z-index:1;
		background:linear-gradient(270deg, rgba(0,0,0,.5) 0%, rgba(0,0,0,.26) 32%, rgba(0,0,0,0) 60%); }
