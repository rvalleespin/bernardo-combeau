---
export const prerender = true;

import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ModeloHeader from '../../components/modelo/ModeloHeader.astro';
import Visor from '../../components/modelo/Visor.astro';
import nav from '../../data/nav.json';
import selectedWorkData from '../../data/modelo/selected-work.json';
import { secciones, conVisor, encuadreStyle } from '../../lib/modelo.js';

// Mismo criterio que la portada: mientras "Modelo" no tenga título en el
// menú, la sección está en obra y no se ofrece a buscadores.
const enObra = !(nav.modelo && nav.modelo.trim());

const selectedWork = selectedWorkData.trabajos;
const selectedV = await Promise.all((selectedWork || []).map(async (job) => ({
	...job, fotos: await conVisor(job.fotos),
})));
---

<Layout title="Bernardo Combeau — Selected Work" description="Selected campaigns and work featuring Bernardo Combeau, model based in Santiago, Chile." noindex={enObra}>
	<div class="modelo">
		<ModeloHeader secciones={secciones} />

		<section class="work">
			<h1>Selected Work</h1>
			<div class="work-list">
				{selectedV.map((job) => {
					const tieneMas = (job.fotos || []).length > 1;
					return (
					<article class="work-item">
						<div class="work-head">
							<p class="work-name">{job.nombre}</p>
							{job.detalle && <p class="work-detalle">{job.detalle}</p>}
						</div>
						{/* Se ve una sola foto por campaña; el resto vive en el DOM sin
						    mostrarse, para que el visor las recorra al abrir. */}
						<div class="work-fotos" data-visor-grupo>
							{(job.fotos || []).map((img, n) => (
								<button class="photo" type="button" aria-haspopup="dialog" data-oculta={n > 0 ? '' : undefined}
									data-lb={JSON.stringify(img.lb)} data-alt={img.alt || job.nombre}>
									{/* Solo la portada (n=0) se ve recortada — el resto vive oculta
									    para el visor, que muestra la foto completa sin recorte. */}
									<Image src={img.src} alt={img.alt || job.nombre} width={1920} height={Math.round(1920 * (img.hReal / img.wReal))} quality={82}
										style={encuadreStyle(img)} />
									{/* Aviso de que hay más fotos adentro — a pedido de Ramón, que al
									    abrir ALTOCONCEPTO (4 fotos) no tenía ninguna señal previa de que
									    existían más. Solo un indicio visual: el clic sigue siendo el
									    mismo (abre el visor, que ya trae sus propias flechas
									    funcionales para recorrerlas). */}
									{n === 0 && tieneMas && (
										<>
											<span class="work-mas work-mas-izq" aria-hidden="true"></span>
											<span class="work-mas work-mas-der" aria-hidden="true"></span>
										</>
									)}
								</button>
							))}
						</div>
						{tieneMas && (
							<p class="work-cuenta">{job.fotos.length} photos</p>
						)}
					</article>
					);
				})}
			</div>
		</section>

		<p class="volver"><a href="/modelo/">← Model</a></p>

		<Visor />
	</div>
</Layout>

<style>
	.modelo{ --mp: #ffffff; --mi: #111110; --mm: #84817a; --ml: #e7e4dd;
		background:var(--mp); color:var(--mi); font-family:-apple-system,BlinkMacSystemFont,sans-serif;
		min-height:100vh; }
	:target{ scroll-margin-top:6.5rem; }

	/* Selected Work va sin gutter dentro de cada cuadro — mismo criterio que en
	   la portada (index.astro), del que se extrajo esta sección. En 2 columnas
	   desde tablet (a pedido de Ramón: con una sola columna el scroll crecía
	   mucho apenas había más de 2-3 campañas cargadas). */
	.work{ padding:clamp(2.6rem,6vw,4.5rem) 0; }
	.work > h1{ font-family:Georgia,'Times New Roman',serif; font-weight:400; font-style:italic;
		font-size:1.45rem; letter-spacing:-.02em; line-height:1.11; color:var(--mm);
		margin:0 clamp(1.4rem,5vw,4rem) clamp(1.8rem,4vw,2.6rem); }
	.work-list{ display:grid; grid-template-columns:1fr; gap:clamp(2.2rem,5vw,3.2rem) clamp(1.4rem,4vw,2.4rem);
		padding:0 clamp(1.4rem,5vw,4rem); }
	@media (min-width:640px){ .work-list{ grid-template-columns:repeat(2,1fr); } }

	.work-head{ text-align:center; margin-bottom:clamp(.9rem,2vw,1.4rem); }
	.work-name{ font-size:.78rem; font-weight:600; letter-spacing:.16em; text-transform:uppercase;
		color:var(--mi); margin:0; }
	.work-detalle{ font-size:.78rem; font-weight:400; letter-spacing:.14em; text-transform:uppercase;
		color:var(--mm); margin:.4rem 0 0; }

	.work-fotos .photo[data-oculta]{ display:none; }
	.work-fotos .photo{ position:relative; width:100%; aspect-ratio:16/10; overflow:hidden; }
	.work-fotos .photo img{ width:100%; height:100%; object-fit:cover; display:block; }
	.work-cuenta{ text-align:center; font-size:.68rem; letter-spacing:.16em; text-transform:uppercase;
		color:var(--mm); margin:.7rem 0 0; }
	@media (max-width:640px){ .work-fotos .photo{ aspect-ratio:4/5; } }

	/* Flechita a cada lado de la portada: avisa que hay más fotos en ese álbum
	   antes de tocarla — antes no había ninguna señal (Ramón lo notó recién al
	   abrir ALTOCONCEPTO y encontrarse con 4 fotos, no 1). Dibujada con CSS
	   (borde de un cuadrado rotado), mismo criterio que el triángulo de play
	   de VideoGrid.astro: sin ícono ni SVG externo. Puramente informativa — el
	   clic sigue abriendo el visor completo, no hace nada por sí sola. */
	.work-mas{ position:absolute; top:50%; transform:translateY(-50%);
		width:2.25rem; height:2.25rem; display:grid; place-items:center; pointer-events:none; }
	.work-mas::after{ content:""; width:.55em; height:.55em; border-style:solid; border-color:#fff;
		border-width:0 2px 2px 0; filter:drop-shadow(0 1px 3px rgba(0,0,0,.55)); }
	.work-mas-izq{ left:.3rem; }
	.work-mas-izq::after{ transform:rotate(135deg); }
	.work-mas-der{ right:.3rem; }
	.work-mas-der::after{ transform:rotate(-45deg); }

	button.photo{ display:block; width:100%; padding:0; border:0; background:none;
		cursor:zoom-in; font:inherit; color:inherit; }
	button.photo:focus-visible{ outline:2px solid var(--mi); outline-offset:3px; }

	.volver{ padding:0 clamp(1.4rem,5vw,4rem) clamp(2.6rem,6vw,4.5rem); }
	.volver a{ color:var(--mm); text-decoration:none; font-size:.82rem; letter-spacing:.03em; }
	.volver a:hover, .volver a:focus-visible{ color:var(--mi); }
</style>
