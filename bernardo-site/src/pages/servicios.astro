---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import services from '../data/servicios.json';
---

<Layout title="Servicios — Bernardo Combeau" description="Servicios y tarifas de Bernardo Combeau: personal branding, retratos corporativos y sesiones a medida.">
	<Nav active="/servicios" />
	<div class="page-head"><h2>Servicios</h2></div>
	<div class="price-list">
		{services.servicios.map((s) => {
			const Fila = s.esCta ? 'a' : 'div';
			return (
				<Fila class="price-row" href={s.esCta ? '/contacto' : undefined}>
					<div class="info">
						<div class="t">{s.titulo}</div>
						<div class="d">{s.descripcion}</div>
					</div>
					<div class:list={["amount", { cta: s.esCta }]}>{s.precio}</div>
				</Fila>
			);
		})}
	</div>
	<Footer />
</Layout>
