---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

import slide1 from '../assets/fotos/bernardo-portafolio-02-metro-urbano.png';
import slide2 from '../assets/fotos/bernardo-portafolio-04-bicicleta-atardecer.png';
import slide3 from '../assets/fotos/bernardo-portafolio-12-torso-bn.png';

const slides = [
  { id: 's1', img: slide1, alt: 'Metro urbano', place: 'Valparaíso, Chile', year: '2024' },
  { id: 's2', img: slide2, alt: 'Bicicleta al atardecer', place: 'Región de Valparaíso, Chile', year: '2024' },
  { id: 's3', img: slide3, alt: 'Torso en blanco y negro', place: 'Santiago, Chile', year: '2025' },
];
---

<Layout title="Series — Bernardo Combeau">
	<Nav active="/series" />

	<p class="crumb">Series /</p>
	<div class="serie-head">
		<h2>Nombre de la serie</h2>
		<p class="y">2024–2025</p>
		<p>Texto breve de contexto — de qué trata la serie, escrito como ensayo, no como ficha técnica de cámara.</p>
	</div>

	{slides.map((s) => <input type="radio" name="slide" id={s.id} class="slide-input" checked={s.id === 's1'} />)}

	<div class="stagewrap">
		<div class="stage">
			{slides.map((s) => (
				<Image src={s.img} alt={s.alt} data-s={s.id} class="simg" widths={[640, 1024, 1600]} sizes="(min-width: 760px) 90vw, 100vw" />
			))}
		</div>

		{slides.map((s) => (
			<div class={`scap on-${s.id}`}><span>{s.place}</span><span>{s.year} · © Bernardo Combeau</span></div>
		))}

		<div class="sctrl">
			{slides.map((s, i) => <label for={s.id}>{String(i + 1).padStart(2, '0')}</label>)}
		</div>
	</div>
	<p class="fn" style="text-align:center;color:var(--mute);font-size:.7rem;margin-top:.6rem;">Cada imagen respeta su composición original.</p>

	<div class="serie-nav">
		<a href="/">← Volver a Home</a>
		<a href="/encargos">Encargos →</a>
	</div>

	<Footer />
</Layout>

<style>
	#s1:checked ~ .stagewrap .stage :global(.simg[data-s="s1"]),
	#s2:checked ~ .stagewrap .stage :global(.simg[data-s="s2"]),
	#s3:checked ~ .stagewrap .stage :global(.simg[data-s="s3"]) { opacity: 1; }

	#s1:checked ~ .stagewrap .scap.on-s1,
	#s2:checked ~ .stagewrap .scap.on-s2,
	#s3:checked ~ .stagewrap .scap.on-s3 { display: flex; }

	#s1:checked ~ .stagewrap .sctrl label[for="s1"],
	#s2:checked ~ .stagewrap .sctrl label[for="s2"],
	#s3:checked ~ .stagewrap .sctrl label[for="s3"] { color: var(--ink); border-bottom-color: var(--ink); }
</style>
