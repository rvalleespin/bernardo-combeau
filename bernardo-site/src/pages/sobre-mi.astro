---
export const prerender = true;

import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import sobremi from '../data/sobremi.json';
---

<Layout
	title="Sobre mí — Bernardo Combeau"
	description="Fotógrafo en Santiago, Chile — dirección de retrato con base en experiencia como modelo."
	image={sobremi.foto || undefined}
>
	<Nav active="/sobre-mi" />
	<div class="page-head"><h2>Sobre mí</h2></div>
	<div class="bio-grid">
		{sobremi.foto ? (
			<div class="photo"><Image src={sobremi.foto} alt="Bernardo Combeau" width={800} quality={80} /></div>
		) : (
			<div class="photo placeholder"><span>[ foto de Bernardo — la está gestionando junto con las de estudio ]</span></div>
		)}
		<div class="bio">
			<p>{sobremi.parrafo1}</p>
			{sobremi.parrafo2 && sobremi.parrafo2.trim().length > 1 && (
				<p style="margin-top:1.1rem;">{sobremi.parrafo2}</p>
			)}
		</div>
	</div>
	<Footer />
</Layout>
