---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import sobremi from '../data/sobremi.json';
---

<Layout title="Sobre mí — Bernardo Combeau">
	<Nav active="/sobre-mi" />
	<div class="page-head"><h2>Sobre mí</h2></div>
	<div class="bio-grid">
		{sobremi.foto ? (
			<div class="photo"><img src={sobremi.foto} alt="Bernardo Combeau" /></div>
		) : (
			<div class="photo placeholder"><span>[ foto de Bernardo — la está gestionando junto con las de estudio ]</span></div>
		)}
		<div class="bio">
			<p>{sobremi.parrafo1}</p>
			<p style="margin-top:1.1rem;">{sobremi.parrafo2}</p>
		</div>
	</div>
	<Footer />
</Layout>
